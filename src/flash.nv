// src/flash.nv — the storage trait a novofs volume sits
// on, and the buffer type it moves bytes through.
//
// A flash driver implements `Flash` to back a volume.  The trait is
// finer-grained than embedded-hal-nv's `BlockDevice`: NOR flash
// programs in small pages but erases in large blocks, and the
// filesystem uses that asymmetry for append-style metadata commits.
//
// Device contract:
//   - erase(b) sets every byte of block b to 0xFF.
//   - prog may only clear bits (NOR semantics).
//   - offsets and lengths are aligned to read_size / prog_size and in
//     range; a violation fails (false) and is never widened.
//   - the geometry is constant for a device's lifetime.
//
// Bytes move through a `Buf`, a `Vec[u8; BUF_CAP]` the caller owns and
// passes by address:
// `read` replaces the buffer's contents with the bytes it read, and
// `prog` programs every byte the buffer holds.  Nothing is allocated
// on either side of the call, which is what lets the same trait serve
// a device build.
//
// Effects: the trait binds one effect parameter, `e`, and every member
// carries it.  Each implementation supplies the effects its own storage
// costs: a board's flash is `impl Flash[hw, async, mutate] for ...`, a host
// image file is `impl Flash[fs] for ...`, memory behind the runtime's
// byte array is `impl Flash[mutate, ffi] for ...`.  The filesystem core
// is generic over `D: Flash[e]` and declares `[mutate, e]`, so a caller
// is charged the effects of the device it passes and nothing else.  The
// host devices live in hostdev.nv, which a device build does not use.

// The largest transfer one `read` or `prog` moves.  A device's
// read_size and prog_size are at most this, and one metadata record,
// header and checksum included, fits in it.
let BUF_CAP = 512

alias Buf = Vec[u8; 512]

trait Flash[e]
    fn read_size(self) -> Int [e]
    fn prog_size(self) -> Int [e]
    fn block_size(self) -> Int [e]
    fn block_count(self) -> Int [e]
    // Replaces `dst`'s contents with the `len` bytes at (block, off).
    fn read(self, block: Int, off: Int, len: Int, var dst: Buf) -> Bool [e]
    // Programs every byte `src` holds at (block, off); `src` is the
    // caller's buffer, passed by address and left as it was.
    fn prog(self, block: Int, off: Int, var src: Buf) -> Bool [e]
    fn erase(self, block: Int) -> Bool [e]
    fn sync(self) -> Bool [e]

// The bytes a file write takes: `src_len` of them, the byte at index
// `i` answered by `src_at`.  The host wraps a `Bytes`; a device wraps
// whatever holds its record.  The core reads a source once, front to
// back, while it programs the file.
trait ByteSrc
    fn src_len(self) -> Int
    fn src_at(self, i: Int) -> Int

// The source of a record that carries no file data.
@value
struct NoSrc
    none: u8

impl ByteSrc for NoSrc
    @tier(embedded)
    fn src_len(self) -> Int
        0

    @tier(embedded)
    fn src_at(self, i: Int) -> Int
        0

// A source of no bytes, for a write that takes nothing from a caller.
pub @tier(embedded)
fn no_src() -> NoSrc
    NoSrc { none: 0 }
