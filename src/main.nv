// src/main.nv — the novofs image-tool CLI, built on the
// nvfs library.  No filesystem logic lives here, only argument parsing
// and output formatting.
//
//   novofs mk <dir> -o image.bin [--target=<board>]
//             [--block-size N] [--block-count N]
//             [--read-size N] [--prog-size N] [--inline-max N]
//             [--name-max N] [--block-cycles N]
//   novofs ls image.bin [path]
//   novofs cat image.bin <path>
//   novofs extract image.bin -o <dir>
//   novofs fsck image.bin
//   novofs df image.bin
//   novofs selfcheck
//
// Determinism: mk deletes any existing image, walks the host tree
// in sorted order, and allocation is cursor-deterministic from a
// fresh format — same input tree + flags ⇒ byte-identical image.
//
// Geometry: mk must be told the TARGET's prog size (metadata
// layout starts records at max(4, prog_size)); the read verbs
// auto-detect geometry by scanning block 0 for the superblock
// record (the 0xFF-skip scan finds it at any prog alignment), so
// they need no flags.  `mk --target=<board>` takes the block size, the
// block count and the page from the board's data region, as
// `novo bsp region --target=<board>` prints them (the toolchain at $NOVO,
// else `novo` on PATH): the toolchain finds the board's manifest, reads
// `block_region` or the `[flash]` table's data region, and knows the
// flash's erase and write units, so the tool does not repeat any of it.
//
// cat prints the file content as text (a NUL byte truncates —
// use extract for binary-exact output).

use std.bytes
use std.env
use std.fs
use std.list
use std.process
use std.str

use hostdev
use nvfs
use hostfs
use vfs

// ── small helpers ───────────────────────────────────────────────────

fn str_lt(a: Str, b: Str) -> Bool
    let la = str.len(a)
    let lb = str.len(b)
    var n = la
    if lb < n
        n = lb
    for i in 0..n
        let ca = str.byte_at(a, i) ?? 0
        let cb = str.byte_at(b, i) ?? 0
        if ca != cb
            return ca < cb
    la < lb

fn sort_strs(xs: [Str]) -> [Str]
    var out: [Str] = []
    for x in xs
        // insert x into out (insertion sort — fixture-scale inputs)
        var placed = false
        var next: [Str] = []
        for y in out
            if not placed and str_lt(x, y)
                next = list.push(next, x)
                placed = true
            next = list.push(next, y)
        if not placed
            next = list.push(next, x)
        out = next
    out

fn flag_val(argv: [Str], name: Str, def: Int) -> Int
    var v = def
    var i = 0
    let n = list.len(argv)
    while i + 1 < n
        if argv[i] == name
            v = str.to_int(argv[i + 1]) ?? def
        i = i + 1
    v

fn flag_str(argv: [Str], name: Str) -> Str
    var v = ""
    var i = 0
    let n = list.len(argv)
    while i + 1 < n
        if argv[i] == name
            v = argv[i + 1]
        i = i + 1
    v

fn host_read_file(p: Str) -> ?Bytes [fs]
    let fd = fs.open_read(p)!
    let sz = fs.size(p) ?? 0 - 1
    if sz < 0
        None
    else if sz == 0
        Some(bytes.from_byte_list([]))
    else
        var out = bytes.from_byte_list([])
        for c in 0..(sz + 4095) / 4096
            let off = c * 4096
            var take = 4096
            if off + take > sz
                take = sz - off
            match fs.read_at(fd, off, take)
                Some(chunk) =>
                    out = out + bytes.from_byte_list(chunk)
                None        =>
                    return None
        Some(out)

fn host_write_file(p: Str, data: Bytes) -> Bool [fs]
    let _ = fs.delete(p)
    let Some(fd) = fs.open_write(p) else return false
    let n = bytes.len(data)
    for c in 0..(n + 4095) / 4096
        let off = c * 4096
        var take = 4096
        if off + take > n
            take = n - off
        let chunk = list.map(list.range(off, off + take), i => bytes.byte_at(data, i) ?? 0)
        match fs.write_at(fd, off, chunk)
            None    => ()
            Some(e) =>
                return false
    true

// ── image open (read verbs): auto-detect geometry from block 0 ──────

enum ImgRes
    ImgOk(vol: Volume<FileFlash>)
    ImgErr(msg: Str)

// The geometry a superblock record in the block at `base` names, as
// [block_size, block_count]; [-1, -1] when the records from base + 4 up
// to `limit` hold none.  The 0xFF-skipping scan finds a record at any
// prog alignment, so the reader needs no flags.
fn sb_geometry(buf: Bytes, base: Int, limit: Int) -> [Int]
    var lim = limit
    if lim > bytes.len(buf)
        lim = bytes.len(buf)
    var off = base + 4
    var bs = 0 - 1
    var bc = 0 - 1
    var stop = false
    while not stop and off + 4 <= lim
        let t = bytes.byte_at(buf, off) ?? 255
        if t == 255
            off = off + 1
        else
            let len = bytes.u16_le_at(buf, off + 2) ?? -1
            if len < 0 or off + 4 + len + 4 > lim
                stop = true
            else
                let stored = bytes.u32_le_at(buf, off + 4 + len) ?? -1
                if stored != hostfs.crc_of_slice(buf, off, off + 4 + len)
                    stop = true
                else
                    if t == 1 and len == 32 and bs < 0
                        bs = bytes.u32_le_at(buf, off + 4 + 8) ?? -1
                        bc = bytes.u32_le_at(buf, off + 4 + 12) ?? -1
                    off = off + 4 + len + 4
    [bs, bc]

fn image_open(p: Str) -> ImgRes [io, fs, mutate, ffi]
    let sz = fs.size(p) ?? 0 - 1
    if sz < 64
        ImgErr("not a novofs image (too small): " + p)
    else
        let Some(fd) = fs.open_read(p) else return ImgErr("cannot open: " + p)
        var probe = 65536
        if probe > sz
            probe = sz
        let Some(head_l) = fs.read_at(fd, 0, probe) else return ImgErr("cannot read: " + p)
        let buf = bytes.from_byte_list(head_l)
        // the superblock record in block 0 — or, when block 0 is caught
        // erased in the middle of a compaction (a board's flash copied
        // out mid-write), in block 1, which sits one block size in
        let geo = sb_geometry(buf, 0, probe)
        var bs = geo[0]
        var bc = geo[1]
        var cand = 64
        // the block sizes 64, 128, 256, ... below the probe's length
        for step in 0..32
            if bs >= 64 or cand >= probe
                break
            let g = sb_geometry(buf, cand, cand + cand)
            if g[0] == cand
                bs = g[0]
                bc = g[1]
            cand = cand * 2
        if bs < 64 or bc < 2
            ImgErr("no superblock found in: " + p)
        else
            let Some(dev) = hostdev.file_flash(p, 1, 1, bs, bc) else
                return ImgErr("cannot map image: " + p)
            let vol = nvfs.mount(dev)
            match vol.mounted()
                MOk(info) => ImgOk(vol)
                MErr(e)   => ImgErr("mount failed: " + nvfs.err_str(e))

// ── mk ──────────────────────────────────────────────────────────────

// Set while mk_build sizes a folder: failures are counted, not printed.
var mk_quiet = false
// The failures for space of the last mk_walk.
var mk_nospace = 0
// The board's name as the toolchain gives it, after board_region.
var mk_board = ""

fn mk_walk(vol: Volume<FileFlash>, host_dir: Str, img_dir: Str) -> Int [io, fs, mutate, ffi]
    // returns number of failures; prints each failure
    var fails = 0
    for name in sort_strs(fs.read_dir(host_dir))
        let hpath = host_dir + "/" + name
        var ipath = img_dir + "/" + name
        if img_dir == "/"
            ipath = "/" + name
        if fs.is_dir(hpath)
            match vol.mkdir(ipath)
                EOk =>
                    fails = fails + mk_walk(vol, hpath, ipath)
                e   =>
                    mk_fail("mk: mkdir " + ipath + ": ", e)
                    fails = fails + 1
        else
            match host_read_file(hpath)
                None       =>
                    if not mk_quiet
                        println("mk: cannot read " + hpath)
                    fails = fails + 1
                Some(data) =>
                    let e = hostfs.file_write(vol, ipath, data)
                    if e != EOk
                        mk_fail("mk: write " + ipath + ": ", e)
                        fails = fails + 1
    fails

fn mk_fail(what: Str, e: FsError) [io, mutate]
    if e == ENoSpace
        mk_nospace = mk_nospace + 1
    if not mk_quiet
        println(what + nvfs.err_str(e))

// Builds the image `out` from the folder `src`: [0, used blocks] when
// every file went in, [1, failures] when some did not (mk_nospace
// counts those refused for space), [2, 0] when the image could not be
// made at all (the reason printed).
fn mk_build(src: Str, out: Str, rs: Int, ps: Int, bs: Int, bc: Int,
            cfg: FsConfig) -> [Int] [io, fs, mutate, ffi]
    let _ = fs.delete(out)
    mk_nospace = 0
    match hostdev.file_flash(out, rs, ps, bs, bc)
        None      =>
            println("mk: cannot create " + out)
            [2, 0]
        Some(dev) =>
            match nvfs.format(dev, cfg)
                EOk =>
                    let vol = nvfs.mount(dev)
                    match vol.mounted()
                        MOk(info) =>
                            let fails = mk_walk(vol, src, "/")
                            if fails == 0
                                [0, vol.used_blocks()]
                            else
                                [1, fails]
                        MErr(em)  =>
                            println("mk: mount: " + nvfs.err_str(em))
                            [2, 0]
                ef  =>
                    println("mk: format: " + nvfs.err_str(ef))
                    [2, 0]

// The blocks of `bs` bytes the folder takes, found by building it into
// a scratch image of twice as many blocks until it fits; 0 when it does
// not fit in 256 MB.
fn mk_blocks_needed(src: Str, out: Str, rs: Int, ps: Int, bs: Int, bc: Int,
                    cfg: FsConfig) -> Int [io, fs, mutate, ffi]
    let scratch = out + ".size"
    var n = bc * 2
    var need = 0
    mk_quiet = true
    while need == 0 and n * bs <= 268435456
        let r = mk_build(src, scratch, rs, ps, bs, n, cfg)
        if r[0] == 0
            need = r[1]
        else if r[0] == 2 or mk_nospace == 0
            n = 268435457 / bs + 1
        n = n * 2
    mk_quiet = false
    let _ = fs.delete(scratch)
    need

// The value after `name`, written `name=value` or `name value`.
fn flag_eq(argv: [Str], name: Str) -> Str
    var v = ""
    let pre = name + "="
    let n = list.len(argv)
    for i in 0..n
        if str.starts_with(argv[i], pre)
            v = str.slice(argv[i], str.len(pre), str.len(argv[i]))
        else if argv[i] == name and i + 1 < n
            v = argv[i + 1]
    v

fn has_flag(argv: [Str], name: Str) -> Bool
    var found = false
    for a in argv
        if a == name or str.starts_with(a, name + "=")
            found = true
    found

// The board's data region as `novo bsp region --target=<board>` prints
// it: [start, bytes, erase, page, blocks]; [] when the toolchain
// refuses, after its reason is printed.
fn board_region(board: Str) -> [Int] [io, mutate]
    let novo = process.env("NOVO") ?? "novo"
    let (out, code) = process.run(novo + " bsp region --target='" + board + "' 2>&1")
    if code != 0
        print(out)
        return []
    var start = 0 - 1
    var bts = 0 - 1
    var erase = 0 - 1
    var page = 0 - 1
    var blocks = 0 - 1
    for line in str.lines(out)
        let kv = str.split(line, " ")
        if list.len(kv) == 2
            let v = kv[1]
            if kv[0] == "board"
                mk_board = v
            else if kv[0] == "start"
                start = parse_num(v)
            else if kv[0] == "bytes"
                bts = str.to_int(v) ?? -1
            else if kv[0] == "erase"
                erase = str.to_int(v) ?? -1
            else if kv[0] == "page"
                page = str.to_int(v) ?? -1
            else if kv[0] == "blocks"
                blocks = str.to_int(v) ?? -1
    if start < 0 or bts <= 0 or erase <= 0 or page <= 0 or blocks < 0
        println("mk: `" + novo + " bsp region --target=" + board + "` printed no region:")
        print(out)
        return []
    [start, bts, erase, page, blocks]

// A decimal number, or a hexadecimal one written 0x...; -1 for neither.
fn parse_num(v: Str) -> Int
    if not str.starts_with(v, "0x")
        return str.to_int(v) ?? -1
    let digits = str.slice(v, 2, str.len(v))
    if str.len(digits) == 0
        return -1
    var n = 0
    for c in str.chars(str.lower(digits))
        let d = str.index("0123456789abcdef", c) ?? -1
        if d < 0
            return -1
        n = n * 16 + d
    n

// A typed geometry option that disagrees with the board's: refused,
// naming both.
fn mk_agree(argv: [Str], flag: Str, board_v: Int, what: Str, board: Str) -> Bool [io]
    if not has_flag(argv, flag)
        return true
    let v = flag_val(argv, flag, board_v)
    if v != board_v
        println("mk: ${flag} ${v} disagrees with the board ${board}: its ${what} is ${board_v}")
        return false
    true

fn cmd_mk(argv: [Str]) [io, fs, mutate, ffi]
    let src = argv[2]
    let out = flag_str(argv, "-o")
    if str.len(out) == 0
        println("mk: missing -o <image>")
        process.exit(2)
    var bs = flag_val(argv, "--block-size", 4096)
    var bc = flag_val(argv, "--block-count", 256)
    var rs = flag_val(argv, "--read-size", 16)
    var ps = flag_val(argv, "--prog-size", 16)
    var board = flag_eq(argv, "--target")
    var region_at = 0 - 1
    if has_flag(argv, "--target")
        if str.len(board) == 0
            println("mk: --target needs a board: --target=<board>")
            process.exit(2)
        let g = board_region(board)
        if list.len(g) == 0
            process.exit(2)
        var agree = mk_agree(argv, "--block-size", g[2], "block, the flash's erase unit,", board)
        agree = mk_agree(argv, "--block-count", g[4], "data region's block count", board) and agree
        agree = mk_agree(argv, "--prog-size", g[3], "page", board) and agree
        agree = mk_agree(argv, "--read-size", g[3], "page", board) and agree
        if not agree
            process.exit(2)
        region_at = g[0]
        if str.len(mk_board) > 0
            board = mk_board
        bs = g[2]
        bc = g[4]
        rs = g[3]
        ps = g[3]
        if bc < 2
            println("mk: the board ${board}'s data region holds ${bc} block of ${bs} bytes, and a novofs volume needs two, its metadata pair")
            process.exit(2)
    var cfg = nvfs.default_config()
    cfg = FsConfig {
        block_cycles: flag_val(argv, "--block-cycles", 100),
        cache_size: cfg.cache_size,
        lookahead_size: cfg.lookahead_size,
        name_max: flag_val(argv, "--name-max", 64),
        file_max: cfg.file_max,
        inline_max: flag_val(argv, "--inline-max", 128) }
    if not fs.is_dir(src)
        println("mk: not a directory: " + src)
        process.exit(2)
    let r = mk_build(src, out, rs, ps, bs, bc, cfg)
    if r[0] == 0
        if region_at >= 0
            println("mk: ${out} ok (${r[1]}/${bc} blocks used), for the data region of ${board} at 0x${hex_str(region_at)}, ${bc} blocks of ${bs} bytes")
        else
            println("mk: ${out} ok (${r[1]}/${bc} blocks used)")
    else if r[0] == 1 and mk_nospace > 0
        let _ = fs.delete(out)
        let need = mk_blocks_needed(src, out, rs, ps, bs, bc, cfg)
        var place = "an image of ${bc} blocks"
        if region_at >= 0
            place = "the data region of ${board}, ${bc} blocks"
        if need == 0
            println("mk: ${src} does not fit ${place} of ${bs} bytes, nor 256 MB of them")
        else
            var short = need - bc
            if short < 1
                short = 1
            println("mk: ${src} does not fit ${place} of ${bs} bytes: it needs ${need} blocks, ${short} more (${short * bs} bytes)")
        process.exit(1)
    else if r[0] == 1
        println("mk: ${r[1]} failures")
        process.exit(1)
    else
        process.exit(1)

fn hex_str(n: Int) -> Str
    let digits = "0123456789ABCDEF"
    if n == 0
        return "0"
    var v = n
    var out = ""
    while v > 0
        out = (str.byte_str_at(digits, v & 15) ?? "0") + out
        v = v >>> 4
    out

// ── ls / cat / df ───────────────────────────────────────────────────

fn kind_ch(k: Int) -> Str
    if k == 1
        "d"
    else
        "f"

fn cmd_ls(argv: [Str]) [io, fs, mutate, ffi]
    match image_open(argv[2])
        ImgErr(m)  =>
            println("ls: " + m)
            process.exit(1)
        ImgOk(vol) =>
            var p = "/"
            if list.len(argv) > 3
                p = argv[3]
            match hostfs.dir_list(vol, p)
                DLErr(e) =>
                    println("ls: " + p + ": " + nvfs.err_str(e))
                    process.exit(1)
                DLOk(es) =>
                    for en in es
                        println(kind_ch(en.kind) + " ${hostfs.entry_size(en)} " + en.name)

fn cmd_cat(argv: [Str]) [io, fs, mutate, ffi]
    if list.len(argv) < 4
        println("cat: usage: novofs cat <image> <path>")
        process.exit(2)
    match image_open(argv[2])
        ImgErr(m)  =>
            println("cat: " + m)
            process.exit(1)
        ImgOk(vol) =>
            match hostfs.file_read(vol, argv[3])
                FErr(e)   =>
                    println("cat: " + argv[3] + ": " + nvfs.err_str(e))
                    process.exit(1)
                FOk(data) =>
                    // text output: the bytes up to the first NUL
                    print(bytes.to_str(data))

fn cmd_df(argv: [Str]) [io, fs, mutate, ffi]
    match image_open(argv[2])
        ImgErr(m)  =>
            println("df: " + m)
            process.exit(1)
        ImgOk(vol) =>
            let used = vol.used_blocks()
            let info = vol.info()
            let total = info.block_count
            println("df: used ${used}/${total} blocks, free ${(total - used) * info.block_size} bytes")

// ── extract / fsck (shared walk) ────────────────────────────────────

// consumes the pluggable FileSystem trait — any impl works here,
// not just novofs (the substitution proof for vfs.nv)
fn extract_walk(fsys: dyn FileSystem, img_dir: Str, host_dir: Str) -> Int [io, fs, mutate, ffi]
    var fails = 0
    match fsys.fs_list(img_dir)
        DLErr(e) =>
            println("extract: " + img_dir + ": " + nvfs.err_str(e))
            fails = fails + 1
        DLOk(es) =>
            for en in es
                var ipath = img_dir + "/" + en.name
                if img_dir == "/"
                    ipath = "/" + en.name
                let hpath = host_dir + "/" + en.name
                if en.kind == 1
                    if fs.mkdir_all(hpath)
                        fails = fails + extract_walk(fsys, ipath, hpath)
                    else
                        println("extract: mkdir " + hpath)
                        fails = fails + 1
                else
                    match fsys.fs_read(ipath)
                        FErr(fe)  =>
                            println("extract: read " + ipath + ": " + nvfs.err_str(fe))
                            fails = fails + 1
                        FOk(data) =>
                            if not host_write_file(hpath, data)
                                println("extract: write " + hpath)
                                fails = fails + 1
    fails

fn cmd_extract(argv: [Str]) [io, fs, mutate, ffi]
    let out = flag_str(argv, "-o")
    if str.len(out) == 0
        println("extract: missing -o <dir>")
        process.exit(2)
    match image_open(argv[2])
        ImgErr(m)  =>
            println("extract: " + m)
            process.exit(1)
        ImgOk(vol) =>
            if not fs.mkdir_all(out)
                println("extract: cannot mkdir " + out)
                process.exit(1)
            let fails = extract_walk(vfs.novofs_file(vol), "/", out)
            if fails == 0
                println("extract: ok")
            else
                println("extract: ${fails} failures")
                process.exit(1)

fn fsck_walk(fsys: dyn FileSystem, p: Str, depth: Int, dirs: Int, files: Int,
             bts: Int) -> [Int] [io, fs, mutate, ffi]
    // returns [ok(0/1), dirs, files, bytes]
    var d = dirs
    var f = files
    var b = bts
    var ok = 1
    if depth > 8
        ok = 0
    else
        match fsys.fs_list(p)
            DLErr(e) =>
                ok = 0
            DLOk(es) =>
                for en in es
                    var child = p + "/" + en.name
                    if p == "/"
                        child = "/" + en.name
                    if en.kind == 1
                        d = d + 1
                        let sub = fsck_walk(fsys, child, depth + 1, d, f, b)
                        if (list.get(sub, 0) ?? 0) == 0
                            ok = 0
                        d = list.get(sub, 1) ?? d
                        f = list.get(sub, 2) ?? f
                        b = list.get(sub, 3) ?? b
                    else
                        match fsys.fs_read(child)
                            FOk(data) =>
                                f = f + 1
                                b = b + bytes.len(data)
                            FErr(fe)  =>
                                ok = 0
    var out: [Int] = []
    out = list.push(out, ok)
    out = list.push(out, d)
    out = list.push(out, f)
    out = list.push(out, b)
    out

fn cmd_fsck(argv: [Str]) [io, fs, mutate, ffi]
    match image_open(argv[2])
        ImgErr(m)  =>
            println("fsck: " + m)
            process.exit(1)
        ImgOk(vol) =>
            let r = fsck_walk(vfs.novofs_file(vol), "/", 0, 0, 0, 0)
            if (list.get(r, 0) ?? 0) == 1
                println("fsck: ok — ${list.get(r, 1) ?? 0} dirs, ${list.get(r, 2) ?? 0} files, ${list.get(r, 3) ?? 0} bytes")
            else
                println("fsck: CORRUPT")
                process.exit(1)

// ── selfcheck (pkg smoke; unchanged behavior) ───────────────────────

fn selfcheck() [io, fs, mutate, ffi]
    let dev = hostdev.ram_flash(16, 16, 512, 16)
    let cfg = nvfs.default_config()
    match nvfs.format(dev, cfg)
        EOk => println("selfcheck: format ok")
        e   => println("selfcheck FAILED: format: " + nvfs.err_str(e))
    match nvfs.mount(dev).mounted()
        MOk(info) =>
            println("selfcheck: mount rev=${info.rev} bs=${info.block_size} bc=${info.block_count} active=${info.active_meta}")
        MErr(e)   => println("selfcheck FAILED: mount: " + nvfs.err_str(e))
    let vol = nvfs.mount(dev)
    match vol.mounted()
        MOk(info2) =>
            if info2.rev == 1 and info2.active_meta == 0
                match vol.mkdir("/boot")
                    EOk =>
                        match hostfs.dir_list(vol, "/")
                            DLOk(es)  =>
                                if list.len(es) == 1
                                    match hostfs.file_write(vol, "/boot/count", bytes.from_byte_list([1, 2, 3]))
                                        EOk =>
                                            match hostfs.file_read(vol, "/boot/count")
                                                FOk(d)   =>
                                                    if bytes.len(d) == 3 and (bytes.byte_at(d, 2) ?? -1) == 3
                                                        println("selfcheck ok")
                                                    else
                                                        println("selfcheck FAILED: file bytes")
                                                FErr(fe) => println("selfcheck FAILED: read: " + nvfs.err_str(fe))
                                        fw  => println("selfcheck FAILED: write: " + nvfs.err_str(fw))
                                else
                                    println("selfcheck FAILED: dir count ${list.len(es)}")
                            DLErr(el) => println("selfcheck FAILED: list: " + nvfs.err_str(el))
                    em  => println("selfcheck FAILED: mkdir: " + nvfs.err_str(em))
            else
                println("selfcheck FAILED: remount drifted rev=${info2.rev}")
        MErr(e2)   => println("selfcheck FAILED: remount: " + nvfs.err_str(e2))

fn usage() [io]
    println("novofs — littlefs-class embedded filesystem (experimental)")
    println("")
    println("usage: novofs <verb> ...")
    println("  mk <dir> -o <image> [--target=<board>]  build image from dir")
    println("     [--block-size N] [--block-count N]  the board's data region, or")
    println("     [--read-size N] [--prog-size N]     the geometry typed here")
    println("     [--inline-max N] [--name-max N] [--block-cycles N]")
    println("  ls <image> [path]                      list a directory")
    println("  cat <image> <path>                     print a file (text)")
    println("  extract <image> -o <dir>               unpack to host dir")
    println("  fsck <image>                           verify the whole tree")
    println("  df <image>                             block usage")
    println("  selfcheck                              RAM-backed smoke test")

fn main() [io, fs, mutate, ffi]
    let argv = env.args()
    if list.len(argv) < 2
        usage()
    else
        let verb = argv[1]
        if verb == "selfcheck"
            selfcheck()
        else if verb == "mk" and list.len(argv) >= 3
            cmd_mk(argv)
        else if verb == "ls" and list.len(argv) >= 3
            cmd_ls(argv)
        else if verb == "cat" and list.len(argv) >= 3
            cmd_cat(argv)
        else if verb == "extract" and list.len(argv) >= 3
            cmd_extract(argv)
        else if verb == "fsck" and list.len(argv) >= 3
            cmd_fsck(argv)
        else if verb == "df" and list.len(argv) >= 3
            cmd_df(argv)
        else
            usage()
