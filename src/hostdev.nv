// src/hostdev.nv — the host devices: RamFlash and
// FileFlash.
//
// Both implement flash.nv's `Flash` trait with the effects their
// storage costs, and neither is reachable from a device build: the
// filesystem core never uses this module.
//
//   - RamFlash keeps its cells in the runtime's unboxed byte array
//     (`Flash[mutate, ffi]`).  It enforces NOR semantics by AND-ing new
//     data into the cells, so an erase-discipline error in the
//     filesystem fails in a host test rather than on hardware.  It also
//     carries the wear counters, the bad-block set and the power-cut
//     injection the torture harness drives.
//   - FileFlash maps an image file (`Flash[fs, mutate]`).  It overwrites
//     plainly: image files are built by the CLI, not wear-cycled.

use std.bytes
use std.fs
use std.list

use flash

// The runtime's unboxed byte arrays, declared locally.
@tier(app)
@ffi("novo_array_i8_alloc")
fn a8_alloc(capacity: Int) -> Int [ffi]
@tier(app)
@ffi("novo_array_i8_get")
fn a8_get(h: Int, i: Int) -> Int [ffi]
@tier(app)
@ffi("novo_array_i8_set")
fn a8_set(h: Int, i: Int, v: Int) [ffi]
@tier(app)
@ffi("novo_array_i8_drop")
fn a8_drop(h: Int) [ffi]
@tier(app)
@ffi("novo_array_i64_alloc")
fn a64_alloc(capacity: Int) -> Int [ffi]
@tier(app)
@ffi("novo_array_i64_get")
fn a64_get(h: Int, i: Int) -> Int [ffi]
@tier(app)
@ffi("novo_array_i64_set")
fn a64_set(h: Int, i: Int, v: Int) [ffi]
@tier(app)
@ffi("novo_array_i64_drop")
fn a64_drop(h: Int) [ffi]

// ── RamFlash — in-memory device for tests ───────────────────────────
//
// The strict device: alignment-checked, range-checked, AND-ing prog.
// Anything the FS layer gets wrong about erase discipline fails here,
// in a host test, instead of on hardware.
//
// Wear/fault instrumentation — per-block erase counters and a
// bad-block set — is module-level, not per-device, and the
// constructor resets it.  It therefore describes the MOST RECENTLY
// created RamFlash only.  Tests use devices serially; two live
// devices share one set of counters.  Both live in the runtime's
// arrays rather than in lists, so the module's own state is plain
// integers: a device build that links this package initialises them
// without touching its heap.

var ram_counts_h = 0 - 1   // Int array: successful erases per block
var ram_bad_h    = 0 - 1   // byte array: 1 marks a failing block
var ram_nblocks  = 0
// the most recent device's ArrayI8 handle.  Torture harnesses that
// create thousands of devices call ram_recycle() between trials
// (the slot table holds 256 handles); it is NOT dropped implicitly
// — probes legitimately keep several live devices at once.
var ram_last_h = 0 - 1

// release the most recently created RamFlash's storage.  Only call
// when that device is dead: its reads/writes go to a freed slot
// afterwards.
pub @tier(app)
fn ram_recycle() [mutate, ffi]
    if ram_last_h >= 0
        a8_drop(ram_last_h)
        ram_last_h = 0 - 1

@tier(app)
fn ram_reset_instrumentation(block_count: Int) [mutate, ffi]
    if ram_counts_h >= 0
        a64_drop(ram_counts_h)
    if ram_bad_h >= 0
        a8_drop(ram_bad_h)
    ram_counts_h = a64_alloc(block_count)
    ram_bad_h = a8_alloc(block_count)
    ram_nblocks = block_count
    for i in 0..block_count
        a64_set(ram_counts_h, i, 0)
        a8_set(ram_bad_h, i, 0)
    ram_ops_left = 0 - 1
    ram_tear = 0 - 1
    ram_op_count = 0

// ── Power-cut injection ─────────────────────────────────────────────
//
// ram_schedule_cut(k, tear): of the next mutating ops (prog/erase),
// k - 1 succeed and op k is the CUT — with tear < 0 it applies nothing,
// with tear >= 0 a prog applies only its first `tear` bytes (AND
// semantics — a mid-page power cut) and an erase erases only the
// first half of the block.  Every op after the cut fails until
// ram_clear_cut() ("power restored").  ram_op_count counts
// successful mutating ops so a dry run measures the trace length.

var ram_ops_left = 0 - 1   // -1 = no cut scheduled; 0 = power is off
var ram_tear     = 0 - 1
var ram_op_count = 0

// Schedules a power cut: of the next progs and erases, `after_ops - 1`
// succeed and the one after them is cut, and every one after the cut
// fails until `ram_clear_cut`; with `after_ops` at 0 power is off at
// once.  With `tear` below 0 the cut operation applies nothing; with
// `tear` at 0 or above a prog applies its first `tear` bytes and an
// erase erases the first half of its block.
pub @tier(app)
fn ram_schedule_cut(after_ops: Int, tear: Int) [mutate]
    ram_ops_left = after_ops
    ram_tear = tear

// Restores power: no cut is scheduled and every operation runs.
pub @tier(app)
fn ram_clear_cut() [mutate]
    ram_ops_left = 0 - 1
    ram_tear = 0 - 1

// The progs and erases that succeeded since the count was last reset
// or the most recent RamFlash was made.
pub @tier(app)
fn ram_op_count_get() -> Int [mutate]
    ram_op_count

// Sets the count `ram_op_count_get` answers to 0.
pub @tier(app)
fn ram_op_count_reset() [mutate]
    ram_op_count = 0

// consume one op from the cut budget: 0 = proceed normally,
// 1 = this op is the cut (apply tear then fail), 2 = power is off
@tier(app)
fn ram_cut_gate() -> Int [mutate]
    if ram_ops_left < 0
        0
    else if ram_ops_left == 0
        2
    else
        ram_ops_left = ram_ops_left - 1
        if ram_ops_left == 0
            1
        else
            0

// mark a block as permanently failing prog + erase
pub @tier(app)
fn ram_mark_bad(b: Int) [mutate, ffi]
    if b >= 0 and b < ram_nblocks
        a8_set(ram_bad_h, b, 1)

// Whether block `b` of the most recent RamFlash is marked failing.
pub @tier(app)
fn ram_is_bad(b: Int) -> Bool [mutate, ffi]
    b >= 0 and b < ram_nblocks and a8_get(ram_bad_h, b) == 1

// successful erases of block b since device creation
pub @tier(app)
fn ram_erase_count(b: Int) -> Int [mutate, ffi]
    if b >= 0 and b < ram_nblocks
        a64_get(ram_counts_h, b)
    else
        0

@tier(app)
fn bump_erase(b: Int) [mutate, ffi]
    if b >= 0 and b < ram_nblocks
        a64_set(ram_counts_h, b, a64_get(ram_counts_h, b) + 1)

struct RamFlash
    h: Int   // ArrayI8 handle, block_size * block_count cells
    rs: Int
    ps: Int
    bs: Int
    bc: Int

// A RamFlash of `block_count` blocks of `block_size` bytes, read in
// units of `read_size` and programmed in pages of `prog_size`, every
// byte erased to 0xFF.  It resets the wear counters, the bad-block set
// and the power-cut schedule, which describe the most recent RamFlash.
pub @tier(app)
fn ram_flash(read_size: Int, prog_size: Int, block_size: Int,
             block_count: Int) -> RamFlash [mutate, ffi]
    ram_reset_instrumentation(block_count)
    let h = a8_alloc(block_size * block_count)
    ram_last_h = h
    // cells init to 0; NOR erased state is 0xFF
    for i in 0..block_size * block_count
        a8_set(h, i, 255)
    RamFlash { h: h, rs: read_size, ps: prog_size, bs: block_size, bc: block_count }

impl Flash[mutate, ffi] for RamFlash
    @tier(app)
    fn read_size(self) -> Int
        self.rs

    @tier(app)
    fn prog_size(self) -> Int
        self.ps

    @tier(app)
    fn block_size(self) -> Int
        self.bs

    @tier(app)
    fn block_count(self) -> Int
        self.bc

    @tier(app)
    fn read(self, block: Int, off: Int, len: Int, var dst: Buf) -> Bool [mutate, ffi]
        dst.clear()
        if block < 0 or block >= self.bc or off < 0 or len < 0 or len > BUF_CAP
            false
        else if off + len > self.bs or off % self.rs != 0 or len % self.rs != 0
            false
        else
            for i in 0..len
                // i8 cells sign-extend on get — mask back to 0..255
                let v = a8_get(self.h, block * self.bs + off + i) & 255
                let _ = dst.push(v as u8)
            true

    @tier(app)
    fn prog(self, block: Int, off: Int, var data: Buf) -> Bool [mutate, ffi]
        let len = data.len()
        if block < 0 or block >= self.bc or off < 0
            false
        else if off + len > self.bs or off % self.ps != 0 or len % self.ps != 0
            false
        else if ram_is_bad(block)
            false
        else
            let gate = ram_cut_gate()
            if gate == 2
                false
            else if gate == 1
                // torn prog: apply only the first ram_tear bytes
                var t = ram_tear
                if t > len
                    t = len
                for it in 0..t
                    let cellt = block * self.bs + off + it
                    let oldt = a8_get(self.h, cellt) & 255
                    let nvt = data[it] as Int
                    a8_set(self.h, cellt, oldt & nvt)
                false
            else
                for i in 0..len
                    let cell = block * self.bs + off + i
                    let old = a8_get(self.h, cell) & 255
                    let nv = data[i] as Int
                    a8_set(self.h, cell, old & nv)
                ram_op_count = ram_op_count + 1
                true

    @tier(app)
    fn erase(self, block: Int) -> Bool [mutate, ffi]
        if block < 0 or block >= self.bc
            false
        else if ram_is_bad(block)
            false
        else
            let gate = ram_cut_gate()
            if gate == 2
                false
            else if gate == 1
                // torn erase: only the first half of the block erases
                for ih in 0..self.bs / 2
                    a8_set(self.h, block * self.bs + ih, 255)
                false
            else
                for i in 0..self.bs
                    a8_set(self.h, block * self.bs + i, 255)
                bump_erase(block)
                ram_op_count = ram_op_count + 1
                true

    @tier(app)
    fn sync(self) -> Bool
        true

// ── FileFlash — image-file device (host; backs the CLI) ─────────────
//
// Two fds on the same path: fs.open_write is O_WRONLY|O_CREAT (no
// read-back through that fd), so reads go through a second
// fs.open_read fd.  Both legs are positional (pread/pwrite), so
// the fds never fight over a file offset.  A fresh file is
// initialised to all-0xFF (erased) across the full geometry.

struct FileFlash
    rfd: Int
    wfd: Int
    rs: Int
    ps: Int
    bs: Int
    bc: Int

// Constructing a FileFlash on a fresh image erases every block through
// the impl's own `erase`, so the constructor carries that method's
// `[fs]`.
pub @tier(app)
fn file_flash(img_path: Str, read_size: Int, prog_size: Int, block_size: Int,
              block_count: Int) -> ?FileFlash [fs]
    let wfd = fs.open_write(img_path)!
    let rfd = fs.open_read(img_path)!
    let dev = FileFlash { rfd: rfd,
        wfd: wfd,
        rs: read_size,
        ps: prog_size,
        bs: block_size,
        bc: block_count }
    // fresh (or short) image → initialise to erased state
    match fs.read_at(rfd, block_size * block_count - 1, 1)
        Some(x) => Some(dev)
        None    =>
            var ok = true
            for b in 0..block_count
                if not dev.erase(b)
                    ok = false
            if ok
                Some(dev)
            else
                None

@tier(app)
fn erased_block_list(n: Int) -> [Int]
    list.map(list.range(0, n), i => 255)

impl Flash[fs] for FileFlash
    @tier(app)
    fn read_size(self) -> Int
        self.rs

    @tier(app)
    fn prog_size(self) -> Int
        self.ps

    @tier(app)
    fn block_size(self) -> Int
        self.bs

    @tier(app)
    fn block_count(self) -> Int
        self.bc

    @tier(app)
    fn read(self, block: Int, off: Int, len: Int, var dst: Buf) -> Bool [fs]
        dst.clear()
        if block < 0 or block >= self.bc or off < 0 or len < 0 or len > BUF_CAP
            false
        else if off + len > self.bs or off % self.rs != 0 or len % self.rs != 0
            false
        else
            // fs.read_at answers all `len` bytes or None: a read that
            // reaches past the end of the image is None, never short.
            match fs.read_at(self.rfd, block * self.bs + off, len)
                Some(got) =>
                    for v in got
                        let _ = dst.push((v & 255) as u8)
                    true
                None      => false

    @tier(app)
    fn prog(self, block: Int, off: Int, var data: Buf) -> Bool [fs]
        let len = data.len()
        if block < 0 or block >= self.bc or off < 0
            false
        else if off + len > self.bs or off % self.ps != 0 or len % self.ps != 0
            false
        else
            var img = bytes.zeros(len)
            for i in 0..len
                img = bytes.set_u8(img, i, data[i] as Int)
            let out = list.map(bytes.to_byte_list(img), b => b as Int)
            // fs.write_at: None on success, Some(err) on failure
            match fs.write_at(self.wfd, block * self.bs + off, out)
                None    => true
                Some(e) => false

    @tier(app)
    fn erase(self, block: Int) -> Bool [fs]
        if block < 0 or block >= self.bc
            false
        else
            match fs.write_at(self.wfd, block * self.bs, erased_block_list(self.bs))
                None    => true
                Some(e) => false

    @tier(app)
    fn sync(self) -> Bool
        true

// ── Raw access in Bytes, for probes that write a device directly ────

// Programs `data` at (block, off) through any device.
pub @tier(app)
fn prog_bytes<D: Flash[e]>(dev: D, block: Int, off: Int, data: Bytes) -> Bool [e]
    var buf: Buf = Vec.new()
    for i in 0..bytes.len(data)
        let _ = buf.push((bytes.byte_at(data, i) ?? 0) as u8)
    dev.prog(block, off, buf)

// The `len` bytes at (block, off) of any device, or None.
pub @tier(app)
fn read_bytes<D: Flash[e]>(dev: D, block: Int, off: Int, len: Int) -> ?Bytes [e]
    var buf: Buf = Vec.new()
    if not dev.read(block, off, len, buf)
        return None
    var out = bytes.zeros(buf.len())
    for i in 0..buf.len()
        out = bytes.set_u8(out, i, buf[i] as Int)
    Some(out)
