// src/vfs.nv — the pluggable filesystem surface.
//
// `FileSystem` is the trait CONSUMERS program against: anything
// that can resolve paths to directories and files.  novofs provides
// impls over its own volumes (NovoFs / NovoFsFile below); a
// third-party filesystem plugs into the same consumers by
// implementing this trait — the result/entry vocabulary (FsError,
// DirListRes, FileRes, DirEntry) is shared from the nvfs and hostfs modules.
// Operations a filesystem cannot support return ENotSupported.
//
// The in-tree proof of substitution: the CLI's fsck and extract
// walks consume `dyn FileSystem`, not novofs directly.
//
// This trait is deliberately path-based, mirroring the methods of a
// mounted volume: no open file handles, so no handle table to keep
// consistent across a power cut, and every operation is one
// atomically-committed record from start to finish.
//
// The wrappers below put the host devices behind the trait; a device
// of another kind implements Flash and gets a wrapper of the same
// shape.

use flash
use hostdev
use nvfs
use hostfs

trait FileSystem[e]
    fn fs_mkdir(self, fpath: Str) -> FsError [e]
    fn fs_list(self, fpath: Str) -> DirListRes [e]
    fn fs_remove(self, fpath: Str) -> FsError [e]
    fn fs_rename(self, old_path: Str, new_path: Str) -> FsError [e]
    fn fs_read(self, fpath: Str) -> FileRes [e]
    fn fs_read_at(self, fpath: Str, off: Int, len: Int) -> FileRes [e]
    fn fs_write(self, fpath: Str, data: Bytes) -> FsError [e]
    fn fs_append(self, fpath: Str, data: Bytes) -> FsError [e]
    fn fs_truncate(self, fpath: Str, new_len: Int) -> FsError [e]
    fn fs_size(self, fpath: Str) -> Int [e]

// ── novofs impls ────────────────────────────────────────────────────
//
// One wrapper per host device, each supplying what its device costs:
// NovoFs over a RamFlash (`[mutate, ffi]`), NovoFsFile over an image
// file (`[fs, mutate]`).  A wrapper over `dyn Flash` would supply the
// union of every Flash impl in the program, which includes the board
// devices (`hw`, `async`) that a host program never calls.

struct NovoFs
    vol: Volume<RamFlash>

// A volume on a RamFlash behind the FileSystem trait.
pub @tier(app)
fn novofs(vol: Volume<RamFlash>) -> NovoFs
    NovoFs { vol: vol }

struct NovoFsFile
    vol: Volume<FileFlash>

// A volume on an image file behind the FileSystem trait.
pub @tier(app)
fn novofs_file(vol: Volume<FileFlash>) -> NovoFsFile
    NovoFsFile { vol: vol }

impl FileSystem[mutate, ffi] for NovoFs
    @tier(app)
    fn fs_mkdir(self, fpath: Str) -> FsError [mutate, ffi]
        self.vol.mkdir(fpath)

    @tier(app)
    fn fs_list(self, fpath: Str) -> DirListRes [mutate, ffi]
        hostfs.dir_list(self.vol, fpath)

    @tier(app)
    fn fs_remove(self, fpath: Str) -> FsError [mutate, ffi]
        self.vol.remove(fpath)

    @tier(app)
    fn fs_rename(self, old_path: Str, new_path: Str) -> FsError [mutate, ffi]
        self.vol.rename(old_path, new_path)

    @tier(app)
    fn fs_read(self, fpath: Str) -> FileRes [mutate, ffi]
        hostfs.file_read(self.vol, fpath)

    @tier(app)
    fn fs_read_at(self, fpath: Str, off: Int, len: Int) -> FileRes [mutate, ffi]
        hostfs.file_read_at(self.vol, fpath, off, len)

    @tier(app)
    fn fs_write(self, fpath: Str, data: Bytes) -> FsError [mutate, ffi]
        hostfs.file_write(self.vol, fpath, data)

    @tier(app)
    fn fs_append(self, fpath: Str, data: Bytes) -> FsError [mutate, ffi]
        hostfs.file_append(self.vol, fpath, data)

    @tier(app)
    fn fs_truncate(self, fpath: Str, new_len: Int) -> FsError [mutate, ffi]
        self.vol.file_truncate(fpath, new_len)

    @tier(app)
    fn fs_size(self, fpath: Str) -> Int [mutate, ffi]
        self.vol.file_size(fpath)

impl FileSystem[fs, mutate] for NovoFsFile
    @tier(app)
    fn fs_mkdir(self, fpath: Str) -> FsError [fs, mutate]
        self.vol.mkdir(fpath)

    @tier(app)
    fn fs_list(self, fpath: Str) -> DirListRes [fs, mutate]
        hostfs.dir_list(self.vol, fpath)

    @tier(app)
    fn fs_remove(self, fpath: Str) -> FsError [fs, mutate]
        self.vol.remove(fpath)

    @tier(app)
    fn fs_rename(self, old_path: Str, new_path: Str) -> FsError [fs, mutate]
        self.vol.rename(old_path, new_path)

    @tier(app)
    fn fs_read(self, fpath: Str) -> FileRes [fs, mutate]
        hostfs.file_read(self.vol, fpath)

    @tier(app)
    fn fs_read_at(self, fpath: Str, off: Int, len: Int) -> FileRes [fs, mutate]
        hostfs.file_read_at(self.vol, fpath, off, len)

    @tier(app)
    fn fs_write(self, fpath: Str, data: Bytes) -> FsError [fs, mutate]
        hostfs.file_write(self.vol, fpath, data)

    @tier(app)
    fn fs_append(self, fpath: Str, data: Bytes) -> FsError [fs, mutate]
        hostfs.file_append(self.vol, fpath, data)

    @tier(app)
    fn fs_truncate(self, fpath: Str, new_len: Int) -> FsError [fs, mutate]
        self.vol.file_truncate(fpath, new_len)

    @tier(app)
    fn fs_size(self, fpath: Str) -> Int [fs, mutate]
        self.vol.file_size(fpath)
