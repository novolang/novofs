// The host devices and the host's view of a volume: RamFlash's NOR
// discipline, wear counters and power cuts, FileFlash over an image
// file, the Bytes-and-lists wrappers, the FileSystem trait, and the
// adapter from a whole-block device.

use std.test
use std.bytes
use std.fs

use hostdev
use nvfs
use hostfs
use vfs
use haladapt

fn want(got: FsError, exp: FsError)
    test.assert_eq_str(nvfs.err_str(got), nvfs.err_str(exp))

fn pattern(n: Int, seed: Int) -> Bytes
    bytes.from_byte_list(list.map(list.range(0, n), i => (seed + i) % 251))

fn page(v: Int) -> Bytes
    bytes.from_byte_list(list.map(list.range(0, 16), i => v))

// A path for an image file in a directory of its own.
fn scratch(name: Str) -> Str [fs]
    fs.temp_dir() + "/" + name

// ── RamFlash ────────────────────────────────────────────────────────

@test
fn test_ram_flash_keeps_nor_discipline()
    hostdev.ram_recycle()
    let dev = hostdev.ram_flash(16, 16, 512, 4)
    test.assert_eq(dev.read_size(), 16)
    test.assert_eq(dev.prog_size(), 16)
    test.assert_eq(dev.block_size(), 512)
    test.assert_eq(dev.block_count(), 4)
    test.assert(dev.sync())
    // a fresh device reads erased
    test.assert_eq(hostdev.read_bytes(dev, 1, 0, 16) ?? page(0), page(255))
    // a prog clears bits and never sets them
    test.assert(hostdev.prog_bytes(dev, 1, 16, page(0x0F)))
    test.assert(hostdev.prog_bytes(dev, 1, 16, page(0xF3)))
    test.assert_eq(hostdev.read_bytes(dev, 1, 16, 16) ?? page(0), page(0x03))
    // reads and progs out of range or off the page are refused
    test.assert_none(hostdev.read_bytes(dev, 4, 0, 16))
    test.assert_none(hostdev.read_bytes(dev, -1, 0, 16))
    test.assert_none(hostdev.read_bytes(dev, 0, 8, 16))
    test.assert_none(hostdev.read_bytes(dev, 0, 0, 600))
    test.assert_none(hostdev.read_bytes(dev, 0, 504, 16))
    test.assert_false(hostdev.prog_bytes(dev, 4, 0, page(0)), "a prog past the device")
    test.assert_false(hostdev.prog_bytes(dev, 0, 8, page(0)), "a prog off the page")
    test.assert_false(hostdev.prog_bytes(dev, 0, 504, page(0)), "a prog past the block")
    test.assert_false(dev.erase(4), "an erase past the device")
    test.assert_false(dev.erase(-1), "an erase before the device")
    // an erase sets every byte and counts
    test.assert(dev.erase(1))
    test.assert_eq(hostdev.read_bytes(dev, 1, 16, 16) ?? page(0), page(255))
    test.assert_eq(hostdev.ram_erase_count(1), 1)
    test.assert_eq(hostdev.ram_erase_count(0), 0)
    test.assert_eq(hostdev.ram_erase_count(9), 0)

@test
fn test_ram_flash_bad_blocks()
    hostdev.ram_recycle()
    let dev = hostdev.ram_flash(16, 16, 512, 4)
    hostdev.ram_mark_bad(2)
    hostdev.ram_mark_bad(9)
    test.assert(hostdev.ram_is_bad(2))
    test.assert_false(hostdev.ram_is_bad(3), "block 3 is good")
    test.assert_false(hostdev.ram_is_bad(9), "block 9 is past the device")
    test.assert_false(dev.erase(2), "a bad block does not erase")
    test.assert_false(hostdev.prog_bytes(dev, 2, 0, page(0)), "a bad block does not program")

@test
fn test_ram_flash_power_cuts()
    hostdev.ram_recycle()
    let dev = hostdev.ram_flash(16, 16, 512, 4)
    hostdev.ram_op_count_reset()
    test.assert(dev.erase(0))
    test.assert_eq(hostdev.ram_op_count_get(), 1)
    // two operations succeed, the third is cut and tears its prog
    // after 4 bytes, and every operation after it fails
    hostdev.ram_schedule_cut(3, 4)
    test.assert(hostdev.prog_bytes(dev, 0, 0, page(0xF0)))
    test.assert(hostdev.prog_bytes(dev, 0, 16, page(0xF0)))
    test.assert_false(hostdev.prog_bytes(dev, 0, 32, page(0x00)), "the cut prog")
    test.assert_false(hostdev.prog_bytes(dev, 0, 48, page(0x00)), "power is off")
    test.assert_false(dev.erase(1), "power is off")
    let torn = hostdev.read_bytes(dev, 0, 32, 16) ?? page(1)
    test.assert_eq(bytes.byte_at(torn, 3) ?? 1, 0)
    test.assert_eq(bytes.byte_at(torn, 4) ?? 1, 255)
    hostdev.ram_clear_cut()
    test.assert(dev.erase(1))
    // a tear longer than the prog applies the whole prog
    hostdev.ram_schedule_cut(1, 100)
    test.assert_false(hostdev.prog_bytes(dev, 1, 0, page(0x11)), "the cut prog")
    hostdev.ram_clear_cut()
    test.assert_eq(hostdev.read_bytes(dev, 1, 0, 16) ?? page(0), page(0x11))
    // a cut erase erases the first half of the block
    test.assert(hostdev.prog_bytes(dev, 2, 0, page(0)))
    test.assert(hostdev.prog_bytes(dev, 2, 496, page(0)))
    hostdev.ram_schedule_cut(1, 0)
    test.assert_false(dev.erase(2), "the cut erase")
    hostdev.ram_clear_cut()
    test.assert_eq(hostdev.read_bytes(dev, 2, 0, 16) ?? page(0), page(255))
    test.assert_eq(hostdev.read_bytes(dev, 2, 496, 16) ?? page(255), page(0))
    // a clean cut applies nothing
    hostdev.ram_schedule_cut(1, -1)
    test.assert_false(hostdev.prog_bytes(dev, 3, 0, page(0)), "the cut prog")
    hostdev.ram_clear_cut()
    test.assert_eq(hostdev.read_bytes(dev, 3, 0, 16) ?? page(0), page(255))

// ── FileFlash ───────────────────────────────────────────────────────

@test
fn test_file_flash_keeps_a_volume_across_handles()
    let p = scratch("vol.img")
    match hostdev.file_flash(p, 16, 16, 512, 16)
        None      => test.fail("file_flash")
        Some(dev) =>
            test.assert_eq(dev.read_size(), 16)
            test.assert_eq(dev.prog_size(), 16)
            test.assert_eq(dev.block_size(), 512)
            test.assert_eq(dev.block_count(), 16)
            test.assert(dev.sync())
            want(nvfs.format(dev, nvfs.default_config()), EOk)
            let vol = nvfs.mount(dev)
            want(hostfs.file_write(vol, "/a", pattern(900, 4)), EOk)
    // a second handle on the same image finds the volume
    match hostdev.file_flash(p, 16, 16, 512, 16)
        None       => test.fail("file_flash again")
        Some(dev2) =>
            let vol2 = nvfs.mount(dev2)
            want(vol2.status(), EOk)
            match hostfs.file_read(vol2, "/a")
                FOk(b)  => test.assert_eq(b, pattern(900, 4))
                FErr(e) => test.fail("read: " + nvfs.err_str(e))
            let d = vol2.unmount()
            test.assert_none(hostdev.read_bytes(d, 16, 0, 16))
            test.assert_none(hostdev.read_bytes(d, 0, 8, 16))
            test.assert_none(hostdev.read_bytes(d, 0, 0, 600))
            test.assert_none(hostdev.read_bytes(d, 0, 504, 16))
            test.assert_false(hostdev.prog_bytes(d, 16, 0, page(0)), "a prog past the image")
            test.assert_false(hostdev.prog_bytes(d, 0, 8, page(0)), "a prog off the page")
            test.assert_false(hostdev.prog_bytes(d, 0, 504, page(0)), "a prog past the block")
            test.assert_false(d.erase(16), "an erase past the image")
            test.assert(hostdev.prog_bytes(d, 9, 0, page(0x42)))
            test.assert_eq(hostdev.read_bytes(d, 9, 0, 16) ?? page(0), page(0x42))
            // a device larger than the image reads short past its end
            let wide = FileFlash { rfd: d.rfd, wfd: d.wfd, rs: 16, ps: 16, bs: 512, bc: 32 }
            test.assert_none(hostdev.read_bytes(wide, 20, 0, 16))

@test
fn test_file_flash_refuses_a_path_it_cannot_open()
    test.assert_none(hostdev.file_flash("/nonexistent-dir/x/vol.img", 16, 16, 512, 4))

// ── The host's view: Bytes, lists, entries ──────────────────────────

@test
fn test_entries_report_their_size()
    hostdev.ram_recycle()
    nvfs.wear_reset()
    let dev = hostdev.ram_flash(16, 16, 512, 32)
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    want(hostfs.file_write(vol, "/s", pattern(30, 0)), EOk)
    want(hostfs.file_write(vol, "/c", pattern(800, 0)), EOk)
    want(vol.file_write("/w", hostfs.src(pattern(5, 5))), EOk)
    match hostfs.dir_list(vol, "/")
        DLErr(e) => test.fail("list: " + nvfs.err_str(e))
        DLOk(es) =>
            test.assert_eq(list.len(es), 4)
            for en in es
                if en.name == "d"
                    test.assert_eq(hostfs.entry_size(en), 0)
                else if en.name == "s"
                    test.assert_eq(hostfs.entry_size(en), 30)
                    test.assert_eq(en.data, pattern(30, 0))
                else if en.name == "c"
                    test.assert_eq(hostfs.entry_size(en), 800)
                else
                    test.assert_eq(hostfs.entry_size(en), 5)

@test
fn test_crc_of_a_slice()
    // the CRC-32C catalogue's check value for "123456789"
    let b = bytes.from_byte_list([0, 49, 50, 51, 52, 53, 54, 55, 56, 57, 0])
    test.assert_eq(hostfs.crc_of_slice(b, 1, 10), 0xE3069283)

// ── The FileSystem trait ────────────────────────────────────────────

fn tree_bytes<F: FileSystem[e]>(f: F, p: Str) -> Int [e]
    match f.fs_list(p)
        DLErr(e) => -1
        DLOk(es) =>
            var total = 0
            for en in es
                if en.kind == 1
                    total = total + tree_bytes(f, p + en.name + "/")
                else
                    total = total + f.fs_size(p + en.name)
            total

@test
fn test_novofs_behind_the_filesystem_trait()
    hostdev.ram_recycle()
    nvfs.wear_reset()
    let dev = hostdev.ram_flash(16, 16, 512, 32)
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    let f = vfs.novofs(nvfs.mount(dev))
    want(f.fs_mkdir("/d"), EOk)
    want(f.fs_write("/d/a", pattern(10, 1)), EOk)
    want(f.fs_append("/d/a", pattern(5, 11)), EOk)
    want(f.fs_write("/b", pattern(600, 0)), EOk)
    test.assert_eq(f.fs_size("/d/a"), 15)
    match f.fs_read("/d/a")
        FOk(b)  => test.assert_eq(b, pattern(15, 1))
        FErr(e) => test.fail("fs_read")
    match f.fs_read_at("/b", 100, 10)
        FOk(b)  => test.assert_eq(b, bytes.slice(pattern(600, 0), 100, 110))
        FErr(e) => test.fail("fs_read_at")
    test.assert_eq(tree_bytes(f, "/"), 615)
    want(f.fs_truncate("/b", 50), EOk)
    want(f.fs_rename("/b", "/c"), EOk)
    want(f.fs_remove("/c"), EOk)
    test.assert_eq(tree_bytes(f, "/"), 15)

@test
fn test_novofs_on_an_image_behind_the_filesystem_trait()
    let p = scratch("vfs.img")
    match hostdev.file_flash(p, 16, 16, 512, 16)
        None      => test.fail("file_flash")
        Some(dev) =>
            want(nvfs.format(dev, nvfs.default_config()), EOk)
            let f = vfs.novofs_file(nvfs.mount(dev))
            want(f.fs_mkdir("/d"), EOk)
            want(f.fs_write("/d/a", pattern(10, 1)), EOk)
            want(f.fs_append("/d/a", pattern(5, 11)), EOk)
            want(f.fs_write("/b", pattern(600, 0)), EOk)
            test.assert_eq(f.fs_size("/d/a"), 15)
            match f.fs_read("/d/a")
                FOk(b)  => test.assert_eq(b, pattern(15, 1))
                FErr(e) => test.fail("fs_read")
            match f.fs_read_at("/b", 100, 10)
                FOk(b)  => test.assert_eq(b, bytes.slice(pattern(600, 0), 100, 110))
                FErr(e) => test.fail("fs_read_at")
            test.assert_eq(tree_bytes(f, "/"), 615)
            want(f.fs_truncate("/b", 50), EOk)
            want(f.fs_rename("/b", "/c"), EOk)
            want(f.fs_remove("/c"), EOk)
            test.assert_eq(tree_bytes(f, "/"), 15)

// ── A whole-block device through the adapter ────────────────────────

@test
fn test_ram_block_moves_whole_blocks()
    let rb = haladapt.ram_block(512, 4)
    test.assert_eq(rb.block_size(), 512)
    test.assert_eq(rb.block_count(), 4)
    var buf: Vec[u8; 512] = Vec.new()
    test.assert(rb.read_block(1, buf))
    test.assert_eq(buf.len(), 512)
    test.assert_eq(buf[0] as Int, 255)
    buf[0] = 7 as u8
    test.assert(rb.write_block(1, buf))
    var back: Vec[u8; 512] = Vec.new()
    test.assert(rb.read_block(1, back))
    test.assert_eq(back[0] as Int, 7)
    test.assert(rb.erase_block(1))
    test.assert(rb.read_block(1, back))
    test.assert_eq(back[0] as Int, 255)
    test.assert_false(rb.read_block(4, back), "a read past the device")
    test.assert_false(rb.write_block(4, buf), "a write past the device")
    test.assert_false(rb.erase_block(4), "an erase past the device")
    var short: Vec[u8; 512] = Vec.new()
    test.assert_false(rb.write_block(0, short), "a write of less than a block")
    let wide = haladapt.ram_block(1024, 1)
    test.assert_false(wide.read_block(0, back), "a block larger than the buffer")

@test
fn test_a_volume_on_a_whole_block_device()
    let bf = haladapt.block_flash(haladapt.ram_block(512, 32))
    test.assert_eq(bf.read_size(), 16)
    test.assert_eq(bf.prog_size(), 16)
    test.assert_eq(bf.block_size(), 512)
    test.assert_eq(bf.block_count(), 32)
    test.assert(bf.sync())
    nvfs.wear_reset()
    want(nvfs.format(bf, nvfs.default_config()), EOk)
    let vol = nvfs.mount(bf)
    want(vol.status(), EOk)
    want(vol.mkdir("/d"), EOk)
    want(hostfs.file_write(vol, "/d/f", pattern(1000, 3)), EOk)
    match hostfs.file_read(vol, "/d/f")
        FOk(b)  => test.assert_eq(b, pattern(1000, 3))
        FErr(e) => test.fail("read: " + nvfs.err_str(e))
    let d = vol.unmount()
    test.assert_none(hostdev.read_bytes(d, 0, 8, 16))
    test.assert_none(hostdev.read_bytes(d, 0, 504, 16))
    test.assert_none(hostdev.read_bytes(d, 32, 0, 16))
    test.assert_false(hostdev.prog_bytes(d, 0, 8, page(0)), "a prog off the page")
    test.assert_false(hostdev.prog_bytes(d, 32, 0, page(0)), "a prog past the device")
    test.assert_false(d.erase(32), "an erase past the device")
    test.assert(hostdev.prog_bytes(d, 30, 0, page(0x0F)))
    test.assert(hostdev.prog_bytes(d, 30, 0, page(0xFC)))
    test.assert_eq(hostdev.read_bytes(d, 30, 0, 16) ?? page(0), page(0x0C))

@test
fn test_file_flash_on_a_device_that_is_full()
    // /dev/full reads zeros and refuses every write
    match hostdev.file_flash("/dev/full", 16, 16, 512, 4)
        None      => test.fail("file_flash /dev/full")
        Some(dev) =>
            test.assert_eq(hostdev.read_bytes(dev, 0, 0, 16) ?? page(1), page(0))
            test.assert_false(hostdev.prog_bytes(dev, 0, 0, page(0)), "a prog the device refuses")
            test.assert_false(dev.erase(0), "an erase the device refuses")

@test
fn test_file_flash_refuses_an_image_it_cannot_erase()
    // a geometry whose blocks sit at negative offsets cannot be erased
    test.assert_none(hostdev.file_flash(scratch("neg.img"), 16, 16, -512, 2))

@test
fn test_file_flash_reads_short_at_the_end_of_an_image()
    let p = scratch("short.img")
    match hostdev.file_flash(p, 8, 8, 512, 2)
        None      => test.fail("file_flash")
        Some(dev) =>
            // a device wider than the image, read across the image's end
            let wide = FileFlash { rfd: dev.rfd, wfd: dev.wfd, rs: 8, ps: 8, bs: 2048, bc: 1 }
            test.assert_none(hostdev.read_bytes(wide, 0, 1016, 16))

// A whole-block device whose erases fail.
struct StuckBlock
    rb: RamBlock

impl BlockDevice for StuckBlock
    fn block_size(self) -> Int [hw]
        self.rb.bs

    fn block_count(self) -> Int [hw]
        self.rb.bc

    fn read_block(self, block: Int, var dst: Vec[u8; 512]) -> Bool [hw, ffi]
        let r = self.rb
        r.read_block(block, dst)

    fn write_block(self, block: Int, var src: Vec[u8; 512]) -> Bool [hw, ffi]
        let r = self.rb
        r.write_block(block, src)

    fn erase_block(self, block: Int) -> Bool [hw]
        false

@test
fn test_the_adapter_answers_an_erase_the_device_refuses()
    let bf = haladapt.block_flash(StuckBlock { rb: haladapt.ram_block(512, 4) })
    test.assert_false(hostdev.prog_bytes(bf, 1, 0, page(0)), "a prog needs an erase")
    test.assert_false(bf.erase(1), "the erase is refused")
