// What a volume does with what the flash holds and what the flash
// refuses: compaction into the sibling block, the relocation of a worn
// metadata pair, superblocks and records written by hand, and devices
// whose reads, progs, erases or syncs fail.

use std.bytes
use std.list
use std.test

use nvfs

// ── The suite's RAM device ──────────────────────────────────────────
//
// RamFlash keeps its cells in one module-level list, each device its
// own run of `bs * bc` cells from `h`.  It enforces NOR rules: offsets
// and lengths are whole units, a prog ANDs its bytes into the cells, and
// an erase sets a block to 0xFF.  It carries the wear counters, the
// bad-block set and the power-cut schedule of the most recent device.
// A suite file is a program of its own, so each suite that needs a
// device carries this block.

var ram_cells: [Int]  = []
var ram_counts: [Int] = []
var ram_bad: [Int]    = []
var ram_nblocks       = 0
var ram_last_h        = 0 - 1
var ram_ops_left      = 0 - 1   // -1: no cut scheduled; 0: power is off
var ram_tear          = 0 - 1
var ram_op_count      = 0

struct RamFlash
    h: Int
    rs: Int
    ps: Int
    bs: Int
    bc: Int

// Releases the most recent device's cells; a device made after it
// reuses them.
fn ram_recycle() [mutate]
    if ram_last_h >= 0
        ram_cells = list.take(ram_cells, ram_last_h)
        ram_last_h = 0 - 1

// A RamFlash of `bc` blocks of `bs` bytes, read in units of `rs` and
// programmed in pages of `ps`, every byte erased to 0xFF.  It resets the
// wear counters, the bad blocks and the power-cut schedule.
fn ram_flash(rs: Int, ps: Int, bs: Int, bc: Int) -> RamFlash [mutate]
    ram_counts = list.map(list.range(0, bc), i => 0)
    ram_bad = list.map(list.range(0, bc), i => 0)
    ram_nblocks = bc
    ram_ops_left = 0 - 1
    ram_tear = 0 - 1
    ram_op_count = 0
    // The new device's cells follow the others, erased.  The list is
    // made again rather than extended: list.concat onto this
    // module-level list leaks one list (novo-lang bug
    // module-var-list-concat-leaks).
    let h = list.len(ram_cells)
    let before = ram_cells
    ram_cells = list.map(list.range(0, h + bs * bc), i => (if i < h then before[i] else 255))
    ram_last_h = h
    RamFlash { h: h, rs: rs, ps: ps, bs: bs, bc: bc }

// Of the next progs and erases, `after_ops - 1` succeed and the next is
// cut: with `tear` below 0 it applies nothing, otherwise a prog applies
// its first `tear` bytes and an erase erases the first half of its
// block.  Every operation after the cut fails until `ram_clear_cut`.
fn ram_schedule_cut(after_ops: Int, tear: Int) [mutate]
    ram_ops_left = after_ops
    ram_tear = tear

fn ram_clear_cut() [mutate]
    ram_ops_left = 0 - 1
    ram_tear = 0 - 1

fn ram_op_count_get() -> Int [mutate]
    ram_op_count

fn ram_op_count_reset() [mutate]
    ram_op_count = 0

// 0: proceed; 1: this operation is the cut; 2: power is off.
fn ram_cut_gate() -> Int [mutate]
    if ram_ops_left < 0
        0
    else if ram_ops_left == 0
        2
    else
        ram_ops_left = ram_ops_left - 1
        if ram_ops_left == 0
            1
        else
            0

fn ram_mark_bad(b: Int) [mutate]
    if b >= 0 and b < ram_nblocks
        ram_bad[b] = 1

fn ram_is_bad(b: Int) -> Bool [mutate]
    b >= 0 and b < ram_nblocks and ram_bad[b] == 1

fn ram_erase_count(b: Int) -> Int [mutate]
    if b >= 0 and b < ram_nblocks
        ram_counts[b]
    else
        0

impl Flash[mutate] for RamFlash
    fn read_size(self) -> Int
        self.rs

    fn prog_size(self) -> Int
        self.ps

    fn block_size(self) -> Int
        self.bs

    fn block_count(self) -> Int
        self.bc

    fn read(self, block: Int, off: Int, len: Int, var dst: Buf) -> Bool [mutate]
        dst.clear()
        if block < 0 or block >= self.bc or off < 0 or len < 0 or len > BUF_CAP
            false
        else if off + len > self.bs or off % self.rs != 0 or len % self.rs != 0
            false
        else
            let base = self.h + block * self.bs + off
            for i in 0..len
                let _ = dst.push(ram_cells[base + i] as u8)
            true

    fn prog(self, block: Int, off: Int, var data: Buf) -> Bool [mutate]
        let len = data.len()
        if block < 0 or block >= self.bc or off < 0
            false
        else if off + len > self.bs or off % self.ps != 0 or len % self.ps != 0
            false
        else if ram_is_bad(block)
            false
        else
            let base = self.h + block * self.bs + off
            let gate = ram_cut_gate()
            if gate == 2
                false
            else if gate == 1
                var t = ram_tear
                if t > len
                    t = len
                for it in 0..t
                    ram_cells[base + it] = ram_cells[base + it] & data[it] as Int
                false
            else
                for i in 0..len
                    ram_cells[base + i] = ram_cells[base + i] & data[i] as Int
                ram_op_count = ram_op_count + 1
                true

    fn erase(self, block: Int) -> Bool [mutate]
        if block < 0 or block >= self.bc
            false
        else if ram_is_bad(block)
            false
        else
            let base = self.h + block * self.bs
            let gate = ram_cut_gate()
            if gate == 2
                false
            else if gate == 1
                for ih in 0..self.bs / 2
                    ram_cells[base + ih] = 255
                false
            else
                for i in 0..self.bs
                    ram_cells[base + i] = 255
                ram_counts[block] = ram_counts[block] + 1
                ram_op_count = ram_op_count + 1
                true

    fn sync(self) -> Bool
        true

// Programs `data` at (block, off) through any device.
fn prog_bytes<D: Flash[e]>(dev: D, block: Int, off: Int, data: Bytes) -> Bool [e]
    var buf: Buf = Vec.new()
    for i in 0..bytes.len(data)
        let _ = buf.push((bytes.byte_at(data, i) ?? 0) as u8)
    dev.prog(block, off, buf)

// The `len` bytes at (block, off) of any device, or None.
fn read_bytes<D: Flash[e]>(dev: D, block: Int, off: Int, len: Int) -> ?Bytes [e]
    var buf: Buf = Vec.new()
    if not dev.read(block, off, len, buf)
        return None
    var out = bytes.zeros(buf.len())
    for i in 0..buf.len()
        out = bytes.set_u8(out, i, buf[i] as Int)
    Some(out)

// ── Whole files and listings, over the volume's operations ─────────

// A Bytes as a source, so a test writes one in a call.  It wraps the
// Bytes because an impl for Bytes itself, written here, is not reached
// from the package's generic code (novo-lang bug
// impl-for-bytes-in-another-module-not-dispatched).
struct BytesSrc
    b: Bytes

impl ByteSrc for BytesSrc
    fn src_len(self) -> Int
        bytes.len(self.b)

    fn src_at(self, i: Int) -> Int
        bytes.byte_at(self.b, i) ?? 0

enum FileRes
    FOk(data: Bytes)
    FErr(e: FsError)

struct DirEntry
    name: Str
    is_dir: Bool
    size: Int

enum DirListRes
    DLOk(entries: [DirEntry])
    DLErr(e: FsError)

fn file_write<D: Flash[e]>(vol: Volume<D>, path: Str, data: Bytes) -> FsError [mutate, e]
    vol.file_write(path, BytesSrc { b: data })

fn file_append<D: Flash[e]>(vol: Volume<D>, path: Str, data: Bytes) -> FsError [mutate, e]
    vol.file_append(path, BytesSrc { b: data })

// `len` bytes of `path` from `off`, a Buf at a time.  A range past the
// end of the file answers EInvalidConfig, and a directory EIsDir.
fn file_read_at<D: Flash[e]>(vol: Volume<D>, path: Str, off: Int, len: Int) -> FileRes [mutate, e]
    match vol.stat(path)
        EntErr(err) => FErr(err)
        EntOk(en)   =>
            if en.is_dir
                return FErr(EIsDir)
            if off < 0 or len < 0 or off + len > en.size
                return FErr(EInvalidConfig)
            var out = bytes.zeros(len)
            var buf: Buf = Vec.new()
            for chunk in 0..(len + BUF_CAP - 1) / BUF_CAP
                let at = chunk * BUF_CAP
                var n = len - at
                if n > BUF_CAP
                    n = BUF_CAP
                let r = vol.file_read_at(path, off + at, n, buf)
                if r != EOk
                    return FErr(r)
                for k in 0..n
                    out = bytes.set_u8(out, at + k, buf[k] as Int)
            FOk(out)

// The whole of `path`, or why it cannot be read.
fn file_read<D: Flash[e]>(vol: Volume<D>, path: Str) -> FileRes [mutate, e]
    match vol.stat(path)
        EntErr(err) => FErr(err)
        EntOk(en)   => file_read_at(vol, path, 0, en.size)

// The entries of `path`, in the order the directory holds them.
fn dir_list<D: Flash[e]>(vol: Volume<D>, path: Str) -> DirListRes [mutate, e]
    var at = vol.list(path)
    if at.err != EOk
        return DLErr(at.err)
    var es: [DirEntry] = []
    while true
        match vol.list_next(at)
            Some(en) =>
                es = list.push(es, DirEntry { name: en.name_str(), is_dir: en.is_dir, size: en.size })
            None     =>
                break
    DLOk(es)

fn entry_size(e: DirEntry) -> Int
    e.size

// ── A device that fails on request ──────────────────────────────────
//
// A RamFlash whose reads of one block fail, whose reads fail after a
// number of them succeed, and whose syncs fail after a number of them
// succeed.  -1 turns each fault off.

var fail_read_block = -1
var reads_left      = -1
var syncs_left      = -1
var reads_done      = 0

fn faults_off() [mutate]
    fail_read_block = -1
    reads_left = -1
    syncs_left = -1

struct FaultFlash
    ram: RamFlash

impl Flash[mutate] for FaultFlash
    fn read_size(self) -> Int
        self.ram.rs

    fn prog_size(self) -> Int
        self.ram.ps

    fn block_size(self) -> Int
        self.ram.bs

    fn block_count(self) -> Int
        self.ram.bc

    fn read(self, block: Int, off: Int, len: Int, var dst: Buf) -> Bool [mutate]
        if block == fail_read_block
            dst.clear()
            return false
        if reads_left == 0
            dst.clear()
            return false
        if reads_left > 0
            reads_left = reads_left - 1
        reads_done = reads_done + 1
        let r = self.ram
        r.read(block, off, len, dst)

    fn prog(self, block: Int, off: Int, var src: Buf) -> Bool [mutate]
        let r = self.ram
        r.prog(block, off, src)

    fn erase(self, block: Int) -> Bool [mutate]
        let r = self.ram
        r.erase(block)

    fn sync(self) -> Bool [mutate]
        if syncs_left == 0
            return false
        if syncs_left > 0
            syncs_left = syncs_left - 1
        true

// ── Helpers ─────────────────────────────────────────────────────────

// Fails unless `got` is `exp`, naming both.
fn want(got: FsError, exp: FsError)
    test.assert_eq_str(nvfs.err_str(got), nvfs.err_str(exp))

fn pattern(n: Int, seed: Int) -> Bytes
    bytes.from_byte_list(list.map(list.range(0, n), i => (seed + i) % 251))

fn cfg_with(cycles: Int) -> FsConfig
    let c = nvfs.default_config()
    FsConfig { block_cycles: cycles, cache_size: c.cache_size, lookahead_size: c.lookahead_size,
               name_max: c.name_max, file_max: c.file_max, inline_max: c.inline_max }

fn ram(bc: Int) -> RamFlash [mutate]
    ram_recycle()
    faults_off()
    nvfs.wear_reset()
    ram_flash(16, 16, 512, bc)

fn fresh(bc: Int) -> Volume<RamFlash> [mutate]
    let dev = ram(bc)
    let _ = nvfs.format(dev, nvfs.default_config())
    nvfs.mount(dev)

fn read_all<D: Flash[e]>(vol: Volume<D>, p: Str) -> Bytes [mutate, e]
    match file_read(vol, p)
        FOk(b)  => b
        FErr(e) => bytes.from_byte_list([255, 255, 255])

fn names<D: Flash[e]>(vol: Volume<D>, p: Str) -> Str [mutate, e]
    match dir_list(vol, p)
        DLErr(e) => "err " + nvfs.err_str(e)
        DLOk(es) =>
            var s = ""
            for en in es
                s = s + en.name + ";"
            s

// Writes one record of type `rtype` with `payload` at (blk, off) and
// answers the offset after it.
fn put_rec<D: Flash[e]>(dev: D, blk: Int, off: Int, rtype: Int, payload: [Int]) -> Int [mutate, e]
    nvfs.wr_begin(dev, blk, off)
    nvfs.rec_head(dev, rtype, list.len(payload))
    for b in payload
        nvfs.rec_byte(dev, b)
    nvfs.rec_tail(dev)
    let _ = nvfs.wr_finish(dev)
    nvfs.wr_pos()

fn u32le(v: Int) -> [Int]
    [v & 255, (v >>> 8) & 255, (v >>> 16) & 255, (v >>> 24) & 255]

// A superblock payload for a device of `bc` blocks of 512 bytes, with
// on-flash version `ver`.
fn sb_payload(ver: Int, bc: Int) -> [Int]
    var p: [Int] = [0x4E, 0x56, 0x46, 0x53]
    for w in [ver, 512, bc, 64, 128, 2147483647, 100]
        p = list.concat(p, u32le(w))
    p

// Block `blk` erased, sealed with revision `rev`, holding one record.
fn hand_block<D: Flash[e]>(dev: D, blk: Int, rev: Int, rtype: Int, payload: [Int]) [mutate, e]
    nvfs.cache_drop()
    let _ = dev.erase(blk)
    let _ = put_rec(dev, blk, 16, rtype, payload)
    let _ = nvfs.seal(dev, blk, rev)

fn dirent_dir(name: Str, p0: Int, p1: Int) -> [Int]
    let nm = list.map(list.range(0, str.len(name)), i => str.byte_at_or(name, i, 0))
    list.concat(list.concat(list.concat([1, str.len(name)], nm), u32le(p0)), u32le(p1))

// ── Compaction ──────────────────────────────────────────────────────

@test
fn test_rewrites_compact_the_root_into_its_sibling()
    let vol = fresh(32)
    want(vol.mkdir("/d"), EOk)
    want(file_write(vol, "/big", pattern(700, 3)), EOk)
    // every rewrite of /f appends a 112-byte record; the fifth does
    // not fit and folds the live state into block 1
    for i in 0..12
        want(file_write(vol, "/f", pattern(100, i)), EOk)
    test.assert_eq(names(vol, "/"), "d;big;f;")
    test.assert_eq(read_all(vol, "/f"), pattern(100, 11))
    test.assert_eq(read_all(vol, "/big"), pattern(700, 3))
    let dev = vol.unmount()
    let again = nvfs.mount(dev)
    want(again.status(), EOk)
    test.assert(again.info().rev > 1)
    test.assert_eq(read_all(again, "/f"), pattern(100, 11))
    test.assert_eq(names(again, "/"), "d;big;f;")

@test
fn test_a_directory_whose_live_state_fills_a_block_refuses_more()
    let vol = fresh(32)
    want(file_write(vol, "/a", pattern(100, 1)), EOk)
    want(file_write(vol, "/b", pattern(100, 2)), EOk)
    want(file_write(vol, "/c", pattern(100, 3)), EOk)
    want(file_write(vol, "/e", pattern(100, 4)), EOk)
    want(file_write(vol, "/g", pattern(100, 5)), ENoSpace)
    test.assert_eq(names(vol, "/"), "a;b;c;e;")

@test
fn test_a_worn_directory_pair_moves_to_fresh_blocks()
    let dev = ram(64)
    want(nvfs.format(dev, cfg_with(2)), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    want(vol.mkdir("/d/e"), EOk)
    var first = 0
    // The pair's first block, read through the internal lookup.
    match nvfs.op_stat(dev, "/d/e")
        AtOk(en) =>
            first = en.pair0 as Int
        AtErr(e) => test.fail("stat: " + nvfs.err_str(e))
    for i in 0..30
        want(file_write(vol, "/d/e/f", pattern(100, i)), EOk)
    match nvfs.op_stat(dev, "/d/e")
        AtOk(en) => test.assert_ne(en.pair0 as Int, first)
        AtErr(e) => test.fail("stat: " + nvfs.err_str(e))
    test.assert_eq(read_all(vol, "/d/e/f"), pattern(100, 29))
    let again = nvfs.mount(vol.unmount())
    test.assert_eq(read_all(again, "/d/e/f"), pattern(100, 29))

@test
fn test_relocation_stops_where_the_volume_is_full()
    let dev = ram(6)
    want(nvfs.format(dev, cfg_with(1)), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    // the two data blocks left are taken, so the pair cannot move
    want(file_write(vol, "/x", pattern(900, 0)), EOk)
    want(file_write(vol, "/d/f", pattern(10, 1)), EOk)
    test.assert_eq(read_all(vol, "/d/f"), pattern(10, 1))

@test
fn test_relocation_survives_a_block_that_will_not_erase()
    let dev = ram(16)
    want(nvfs.format(dev, cfg_with(1)), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    // the allocator hands out 4 and 5 for the move; neither erases
    ram_mark_bad(4)
    ram_mark_bad(5)
    want(file_write(vol, "/d/f", pattern(10, 1)), EOk)
    want(file_write(vol, "/d/f", pattern(10, 2)), EOk)
    test.assert_eq(read_all(vol, "/d/f"), pattern(10, 2))

// ── Superblocks and records written by hand ─────────────────────────

@test
fn test_a_superblock_of_a_newer_major_version_is_refused()
    let dev = ram(16)
    hand_block(dev, 0, 1, 1, sb_payload(0x00020000, 16))
    want(nvfs.mount(dev).status(), EVersion)

@test
fn test_a_short_superblock_is_refused()
    let dev = ram(16)
    // the magic and nothing after it: every field reads -1
    hand_block(dev, 0, 1, 1, [0x4E, 0x56, 0x46, 0x53])
    want(nvfs.mount(dev).status(), EVersion)
    // two bytes of magic
    hand_block(dev, 0, 1, 1, [0x4E, 0x56])
    want(nvfs.mount(dev).status(), ECorrupt)
    // the wrong magic
    hand_block(dev, 0, 1, 1, [0x4E, 0x56, 0x46, 0x54])
    want(nvfs.mount(dev).status(), ECorrupt)

@test
fn test_a_root_without_a_superblock_is_corrupt()
    let dev = ram(16)
    hand_block(dev, 0, 1, 2, dirent_dir("a", 4, 5))
    want(nvfs.mount(dev).status(), ECorrupt)

@test
fn test_the_sealed_block_with_records_wins_over_a_bare_torn_one()
    let dev = ram(16)
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    // block 1 sealed with a high revision and garbage behind it, as an
    // erase cut short can leave it
    nvfs.cache_drop()
    let _ = dev.erase(1)
    let _ = prog_bytes(dev,
        1,
        0,
        bytes.from_byte_list([9, 0, 0, 0, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255]))
    let _ = prog_bytes(dev, 1, 16, bytes.from_byte_list([2, 0, 4, 0, 1, 2, 3, 4, 0, 0, 0, 0, 255, 255, 255, 255]))
    let vol = nvfs.mount(dev)
    want(vol.status(), EOk)
    test.assert_eq(vol.info().active_meta, 0)
    want(file_write(vol, "/a", pattern(5, 0)), EOk)
    // the same garbage in block 0, with the volume in block 1
    let dev2 = ram(16)
    want(nvfs.format(dev2, nvfs.default_config()), EOk)
    let v2 = nvfs.mount(dev2)
    for i in 0..5
        want(file_write(v2, "/f", pattern(100, i)), EOk)
    let d2 = v2.unmount()
    nvfs.cache_drop()
    let _ = d2.erase(0)
    let _ = prog_bytes(d2,
        0,
        0,
        bytes.from_byte_list([9, 0, 0, 0, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255]))
    let _ = prog_bytes(d2, 0, 16, bytes.from_byte_list([2, 0, 4, 0, 1, 2, 3, 4, 0, 0, 0, 0, 255, 255, 255, 255]))
    let v3 = nvfs.mount(d2)
    want(v3.status(), EOk)
    test.assert_eq(v3.info().active_meta, 1)
    test.assert_eq(read_all(v3, "/f"), pattern(100, 4))

@test
fn test_the_higher_revision_wins_and_a_lone_sibling_mounts()
    let vol = fresh(16)
    for i in 0..5
        want(file_write(vol, "/f", pattern(100, i)), EOk)
    let dev = vol.unmount()
    let v1 = nvfs.mount(dev)
    test.assert_eq(v1.info().active_meta, 1)
    for i in 0..5
        want(file_write(v1, "/f", pattern(100, i + 10)), EOk)
    let d1 = v1.unmount()
    let v2 = nvfs.mount(d1)
    test.assert_eq(v2.info().active_meta, 0)
    test.assert_eq(read_all(v2, "/f"), pattern(100, 14))
    // rewrite until the volume is in block 1 again
    var n = 20
    for i in 0..10
        want(file_write(v2, "/f", pattern(100, n)), EOk)
        if (nvfs.pair_state(v2.dev, 0, 1).blk as Int) == 1
            break
        n = n + 1
    let d2 = v2.unmount()
    // block 0 erased: block 1 alone holds the volume
    nvfs.cache_drop()
    let _ = d2.erase(0)
    let v3 = nvfs.mount(d2)
    want(v3.status(), EOk)
    test.assert_eq(v3.info().active_meta, 1)
    test.assert_eq(read_all(v3, "/f"), pattern(100, n))

@test
fn test_a_directory_entry_naming_erased_blocks_is_corrupt()
    let vol = fresh(32)
    let dev = vol.unmount()
    // /x names the pair (20, 21), which holds nothing; /y names one
    // block twice; /z names blocks past the device
    let s = Spec { rtype: 2, kind: 1, a: Span { lo: 1, hi: 2 }, b: Span { lo: 0, hi: 0 }, p0: 20, p1: 21 }
    var stage: Buf = Vec.new()
    want(nvfs.commit(dev, 0, 1, s, "/x", "/x", stage), EOk)
    let s2 = Spec { rtype: 2, kind: 1, a: Span { lo: 1, hi: 2 }, b: Span { lo: 0, hi: 0 }, p0: 5, p1: 5 }
    want(nvfs.commit(dev, 0, 1, s2, "/y", "/y", stage), EOk)
    let s3 = Spec { rtype: 2, kind: 1, a: Span { lo: 1, hi: 2 }, b: Span { lo: 0, hi: 0 }, p0: 40, p1: 41 }
    want(nvfs.commit(dev, 0, 1, s3, "/z", "/z", stage), EOk)
    let v = nvfs.mount(dev)
    want(v.status(), EOk)
    want(v.mkdir("/x/a"), ECorrupt)
    want(v.mkdir("/x/a/b"), ECorrupt)
    want(v.mkdir("/y/a"), ECorrupt)
    want(v.mkdir("/z/a"), ECorrupt)
    want(v.remove("/x/a"), ECorrupt)
    want(v.remove("/x"), ECorrupt)
    want(v.rename("/x/a", "/x/b"), ECorrupt)
    want(file_write(v, "/x/a", pattern(1, 0)), ECorrupt)
    want(v.list("/x").err, ECorrupt)
    match file_read(v, "/x/a")
        FOk(b)  => test.fail("read under a corrupt directory")
        FErr(e) => want(e, ECorrupt)
    // the walk that marks live blocks passes over the broken pairs
    test.assert(v.used_blocks() >= 2)

@test
fn test_a_commit_to_a_pair_that_holds_nothing_is_corrupt()
    let vol = fresh(16)
    let dev = vol.unmount()
    let s = Spec { rtype: 3, kind: 0, a: Span { lo: 1, hi: 2 }, b: Span { lo: 0, hi: 0 }, p0: 0, p1: 0 }
    var stage: Buf = Vec.new()
    want(nvfs.commit(dev, 10, 11, s, "/a", "/a", stage), ECorrupt)

@test
fn test_a_rename_onto_a_name_whose_old_name_is_absent_keeps_the_name()
    let vol = fresh(32)
    want(file_write(vol, "/b", pattern(7, 7)), EOk)
    let dev = vol.unmount()
    // a rename record from "a", which does not exist, onto "b"
    let s = Spec { rtype: 4, kind: 0, a: Span { lo: 1, hi: 2 }, b: Span { lo: 3, hi: 4 }, p0: 0, p1: 0 }
    var stage: Buf = Vec.new()
    want(nvfs.commit(dev, 0, 1, s, "/a", "/x/b", stage), EOk)
    let v = nvfs.mount(dev)
    test.assert_eq(read_all(v, "/b"), pattern(7, 7))
    test.assert_eq(names(v, "/"), "b;")

@test
fn test_a_dirent_shorter_than_its_header_reads_as_empty()
    let dev = ram(16)
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    // an inline dirent whose name length runs past its payload
    let _ = put_rec(dev, 0, 64, 2, [2, 9, 97])
    nvfs.cache_drop()
    let r = nvfs.rec_at(dev, 0, 64, 512)
    test.assert(r.ok)
    let en = nvfs.dec_dirent(dev, 0, r)
    test.assert_eq(en.size as Int, 0)
    // a dirent with no payload at all
    let _ = put_rec(dev, 0, 80, 2, [])
    nvfs.cache_drop()
    let r2 = nvfs.rec_at(dev, 0, 80, 512)
    let en2 = nvfs.dec_dirent(dev, 0, r2)
    test.assert_eq(en2.kind as Int, 0)
    test.assert_eq(en2.pair0 as Int, 0)

// ── Devices that fail ───────────────────────────────────────────────

@test
fn test_an_append_the_device_refuses_is_an_io_error()
    let vol = fresh(16)
    ram_mark_bad(0)
    want(file_write(vol, "/a", pattern(5, 0)), EIo)

@test
fn test_a_compaction_the_device_refuses_is_an_io_error()
    let vol = fresh(16)
    for i in 0..4
        want(file_write(vol, "/f", pattern(100, i)), EOk)
    // the erase of the sibling fails
    ram_mark_bad(1)
    want(file_write(vol, "/f", pattern(100, 9)), EIo)
    test.assert_eq(read_all(vol, "/f"), pattern(100, 3))

@test
fn test_a_compaction_cut_at_each_step_keeps_the_old_state()
    // count the operations the compacting write takes, then cut power
    // at each of them in turn
    let vol = fresh(16)
    for i in 0..4
        want(file_write(vol, "/f", pattern(100, i)), EOk)
    ram_op_count_reset()
    want(file_write(vol, "/f", pattern(100, 9)), EOk)
    let n = ram_op_count_get()
    test.assert(n >= 3)
    for k in 1..n + 1
        let v = fresh(16)
        for i in 0..4
            want(file_write(v, "/f", pattern(100, i)), EOk)
        ram_schedule_cut(k, -1)
        let r = file_write(v, "/f", pattern(100, 9))
        ram_clear_cut()
        want(r, EIo)
        let again = nvfs.mount(v.unmount())
        want(again.status(), EOk)
        test.assert_eq(read_all(again, "/f"), pattern(100, 3))

@test
fn test_a_sync_the_device_refuses()
    // format: the sync after the record, after the seal, and the last
    for k in 0..3
        let dev = FaultFlash { ram: ram(16) }
        syncs_left = k
        want(nvfs.format(dev, nvfs.default_config()), EIo)
        faults_off()
    // an append
    let d1 = FaultFlash { ram: ram(16) }
    want(nvfs.format(d1, nvfs.default_config()), EOk)
    let v1 = nvfs.mount(d1)
    syncs_left = 0
    want(file_write(v1, "/a", pattern(5, 0)), EIo)
    faults_off()
    // a compaction, before and after its seal
    for k in 0..2
        let d2 = FaultFlash { ram: ram(16) }
        want(nvfs.format(d2, nvfs.default_config()), EOk)
        let v2 = nvfs.mount(d2)
        for i in 0..4
            want(file_write(v2, "/f", pattern(100, i)), EOk)
        syncs_left = k
        want(file_write(v2, "/f", pattern(100, 9)), EIo)
        faults_off()
    // a chain's last sync
    let d3 = FaultFlash { ram: ram(16) }
    want(nvfs.format(d3, nvfs.default_config()), EOk)
    let v3 = nvfs.mount(d3)
    syncs_left = 0
    want(file_write(v3, "/big", pattern(700, 0)), EIo)
    faults_off()

@test
fn test_a_root_that_cannot_be_read_is_corrupt()
    let dev = FaultFlash { ram: ram(16) }
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    fail_read_block = 0
    want(nvfs.mount(dev).status(), ECorrupt)
    faults_off()

@test
fn test_reads_that_fail_part_way()
    // every count of reads before the failure, over a volume with a
    // directory, an inline file and a chain
    for k in 0..400
        let dev = FaultFlash { ram: ram(16) }
        want(nvfs.format(dev, nvfs.default_config()), EOk)
        let vol = nvfs.mount(dev)
        want(vol.mkdir("/d"), EOk)
        want(file_write(vol, "/d/s", pattern(50, 1)), EOk)
        want(file_write(vol, "/d/c", pattern(1200, 2)), EOk)
        let v = nvfs.mount(vol.unmount())
        reads_left = k
        let _ = file_read(v, "/d/c")
        let _ = file_read(v, "/d/s")
        let _ = dir_list(v, "/d")
        let _ = file_append(v, "/d/c", pattern(10, 0))
        let _ = v.file_truncate("/d/c", 700)
        let _ = v.rename("/d/s", "/d/t")
        let _ = v.used_blocks()
        faults_off()

// A volume whose root is one rewrite from a compaction and whose
// directory /d/e moves to fresh blocks on every commit.
fn moving_volume(rs: Int, ps: Int, bs: Int) -> Volume<FaultFlash> [mutate]
    ram_recycle()
    faults_off()
    nvfs.wear_reset()
    let dev = FaultFlash { ram: ram_flash(rs, ps, bs, 32) }
    want(nvfs.format(dev, cfg_with(1)), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    want(vol.mkdir("/d/e"), EOk)
    want(file_write(vol, "/d/e/s", pattern(60, 1)), EOk)
    want(file_write(vol, "/d/e/c", pattern(700, 2)), EOk)
    for i in 0..(bs - 64) / 112
        want(file_write(vol, "/f", pattern(100, i)), EOk)
    nvfs.mount(vol.unmount())

fn moving_work(v: Volume<FaultFlash>) [mutate]
    let _ = file_write(v, "/f", pattern(100, 9))
    let _ = file_write(v, "/d/e/s", pattern(60, 9))
    let _ = file_append(v, "/d/e/s", pattern(10, 0))
    let _ = v.file_truncate("/d/e/s", 20)
    let _ = file_read(v, "/d/e/c")

@test
fn test_reads_that_fail_part_way_through_a_compaction_and_a_move()
    for g in 0..3
        var rs = 16
        var ps = 16
        var bs = 512
        if g == 1
            rs = 1
            ps = 1
            bs = 1024
        else if g == 2
            rs = 4
            ps = 4
            bs = 2048
        let v0 = moving_volume(rs, ps, bs)
        reads_done = 0
        moving_work(v0)
        let n = reads_done
        for k in 0..n + 1
            let v = moving_volume(rs, ps, bs)
            reads_left = k
            moving_work(v)
            faults_off()

@test
fn test_reads_that_fail_part_way_through_a_mount()
    for g in 0..2
        ram_recycle()
        faults_off()
        nvfs.wear_reset()
        var ramdev = ram_flash(16, 16, 512, 16)
        var files = 3
        if g == 1
            ramdev = ram_flash(1, 1, 2048, 16)
            files = 20
        want(nvfs.format(ramdev, nvfs.default_config()), EOk)
        let vol = nvfs.mount(ramdev)
        want(vol.mkdir("/d"), EOk)
        for i in 0..files
            want(file_write(vol, "/a" + str.from_int(i), pattern(50 + i, i)), EOk)
        let dev = FaultFlash { ram: vol.unmount() }
        reads_done = 0
        let _ = nvfs.mount(dev).status()
        let n = reads_done
        for k in 0..n + 1
            faults_off()
            reads_left = k
            let _ = nvfs.mount(dev).status()
            faults_off()

// A rename record from `old` onto `new`, committed to the root as it
// stands, whether or not `old` exists.
fn hand_rename<D: Flash[e]>(dev: D, old: Str, new: Str) -> FsError [mutate, e]
    let both = old + new
    let s = Spec { rtype: 4, kind: 0, a: Span { lo: 0, hi: str.len(old) },
                   b: Span { lo: str.len(old), hi: str.len(both) }, p0: 0, p1: 0 }
    var stage: Buf = Vec.new()
    nvfs.commit(dev, 0, 1, s, both, both, stage)

@test
fn test_a_rename_chain_through_an_absent_name_backs_out_a_level()
    let vol = fresh(32)
    want(file_write(vol, "/b", pattern(6, 6)), EOk)
    let dev = vol.unmount()
    // y, which never existed, onto b; then b onto c
    want(hand_rename(dev, "y", "b"), EOk)
    want(hand_rename(dev, "b", "c"), EOk)
    let v = nvfs.mount(dev)
    test.assert_eq(read_all(v, "/c"), pattern(6, 6))
    test.assert_eq(names(v, "/"), "c;")
    // q, which never existed, onto p; then p onto r: nothing is named
    let d2 = v.unmount()
    want(hand_rename(d2, "q", "p"), EOk)
    want(hand_rename(d2, "p", "r"), EOk)
    let v2 = nvfs.mount(d2)
    match v2.stat("/r")
        EntOk(en) => test.fail("r names an entry")
        EntErr(e) => want(e, ENotFound)

@test
fn test_renames_from_an_absent_name_stop_at_the_depth_bound()
    ram_recycle()
    faults_off()
    nvfs.wear_reset()
    let dev = ram_flash(16, 16, 4096, 16)
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    for i in 0..40
        want(hand_rename(dev, "y", "a"), EOk)
    let v = nvfs.mount(dev)
    match v.stat("/a")
        EntOk(en) => test.fail("a names an entry")
        EntErr(e) => want(e, ENotFound)

@test
fn test_a_record_header_that_straddles_two_read_windows()
    // 30-byte records on a device that reads single bytes: a record's
    // header can start in one short read window and end in the next
    ram_recycle()
    faults_off()
    nvfs.wear_reset()
    let ramdev = ram_flash(1, 1, 2048, 8)
    want(nvfs.format(ramdev, nvfs.default_config()), EOk)
    let vol = nvfs.mount(ramdev)
    for i in 10..50
        want(file_write(vol, "/a" + str.from_int(i), pattern(17, i)), EOk)
    let dev = FaultFlash { ram: vol.unmount() }
    let v0 = nvfs.mount(dev)
    reads_done = 0
    let _ = v0.stat("/zz")
    let n = reads_done
    for k in 0..n + 1
        let v = nvfs.mount(dev)
        reads_left = k
        match v.stat("/zz")
            EntOk(en) => test.fail("zz names an entry")
            EntErr(e) => test.assert(e == ENotFound or e == ECorrupt)
        faults_off()
