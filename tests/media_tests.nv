// What a volume does with what the flash holds and what the flash
// refuses: compaction into the sibling block, the relocation of a worn
// metadata pair, superblocks and records written by hand, and devices
// whose reads, progs, erases or syncs fail.

use std.test
use std.bytes

use flash
use hostdev
use meta
use nvfs
use hostfs

// ── A device that fails on request ──────────────────────────────────
//
// A RamFlash whose reads of one block fail, whose reads fail after a
// number of them succeed, and whose syncs fail after a number of them
// succeed.  -1 turns each fault off.

var fail_read_block = -1
var reads_left      = -1
var syncs_left      = -1
var reads_done      = 0

fn faults_off() [mutate]
    fail_read_block = -1
    reads_left = -1
    syncs_left = -1

struct FaultFlash
    ram: RamFlash

impl Flash[mutate, ffi] for FaultFlash
    fn read_size(self) -> Int
        self.ram.rs

    fn prog_size(self) -> Int
        self.ram.ps

    fn block_size(self) -> Int
        self.ram.bs

    fn block_count(self) -> Int
        self.ram.bc

    fn read(self, block: Int, off: Int, len: Int, var dst: Buf) -> Bool [mutate, ffi]
        if block == fail_read_block
            dst.clear()
            return false
        if reads_left == 0
            dst.clear()
            return false
        if reads_left > 0
            reads_left = reads_left - 1
        reads_done = reads_done + 1
        let r = self.ram
        r.read(block, off, len, dst)

    fn prog(self, block: Int, off: Int, var src: Buf) -> Bool [mutate, ffi]
        let r = self.ram
        r.prog(block, off, src)

    fn erase(self, block: Int) -> Bool [mutate, ffi]
        let r = self.ram
        r.erase(block)

    fn sync(self) -> Bool [mutate]
        if syncs_left == 0
            return false
        if syncs_left > 0
            syncs_left = syncs_left - 1
        true

// ── Helpers ─────────────────────────────────────────────────────────

// Fails unless `got` is `exp`, naming both.
fn want(got: FsError, exp: FsError)
    test.assert_eq_str(nvfs.err_str(got), nvfs.err_str(exp))

fn pattern(n: Int, seed: Int) -> Bytes
    bytes.from_byte_list(list.map(list.range(0, n), i => (seed + i) % 251))

fn cfg_with(cycles: Int) -> FsConfig
    let c = nvfs.default_config()
    FsConfig { block_cycles: cycles, cache_size: c.cache_size, lookahead_size: c.lookahead_size,
               name_max: c.name_max, file_max: c.file_max, inline_max: c.inline_max }

fn ram(bc: Int) -> RamFlash [mutate, ffi]
    ram_recycle()
    faults_off()
    nvfs.wear_reset()
    hostdev.ram_flash(16, 16, 512, bc)

fn fresh(bc: Int) -> Volume<RamFlash> [mutate, ffi]
    let dev = ram(bc)
    let _ = nvfs.format(dev, nvfs.default_config())
    nvfs.mount(dev)

fn read_all<D: Flash[e]>(vol: Volume<D>, p: Str) -> Bytes [mutate, e]
    match hostfs.file_read(vol, p)
        FOk(b)  => b
        FErr(e) => bytes.from_byte_list([255, 255, 255])

fn names<D: Flash[e]>(vol: Volume<D>, p: Str) -> Str [mutate, e]
    match hostfs.dir_list(vol, p)
        DLErr(e) => "err " + nvfs.err_str(e)
        DLOk(es) =>
            var s = ""
            for en in es
                s = s + en.name + ";"
            s

// Writes one record of type `rtype` with `payload` at (blk, off) and
// answers the offset after it.
fn put_rec<D: Flash[e]>(dev: D, blk: Int, off: Int, rtype: Int, payload: [Int]) -> Int [mutate, e]
    meta.wr_begin(dev, blk, off)
    meta.rec_head(dev, rtype, list.len(payload))
    for b in payload
        meta.rec_byte(dev, b)
    meta.rec_tail(dev)
    let _ = meta.wr_finish(dev)
    meta.wr_pos()

fn u32le(v: Int) -> [Int]
    [v & 255, (v >>> 8) & 255, (v >>> 16) & 255, (v >>> 24) & 255]

// A superblock payload for a device of `bc` blocks of 512 bytes, with
// on-flash version `ver`.
fn sb_payload(ver: Int, bc: Int) -> [Int]
    var p: [Int] = [0x4E, 0x56, 0x46, 0x53]
    for w in [ver, 512, bc, 64, 128, 2147483647, 100]
        p = list.concat(p, u32le(w))
    p

// Block `blk` erased, sealed with revision `rev`, holding one record.
fn hand_block<D: Flash[e]>(dev: D, blk: Int, rev: Int, rtype: Int, payload: [Int]) [mutate, e]
    meta.cache_drop()
    let _ = dev.erase(blk)
    let _ = put_rec(dev, blk, 16, rtype, payload)
    let _ = meta.seal(dev, blk, rev)

fn dirent_dir(name: Str, p0: Int, p1: Int) -> [Int]
    let nm = list.map(list.range(0, str.len(name)), i => str.byte_at_or(name, i, 0))
    list.concat(list.concat(list.concat([1, str.len(name)], nm), u32le(p0)), u32le(p1))

// ── Compaction ──────────────────────────────────────────────────────

@test
fn test_rewrites_compact_the_root_into_its_sibling()
    let vol = fresh(32)
    want(vol.mkdir("/d"), EOk)
    want(hostfs.file_write(vol, "/big", pattern(700, 3)), EOk)
    // every rewrite of /f appends a 112-byte record; the fifth does
    // not fit and folds the live state into block 1
    for i in 0..12
        want(hostfs.file_write(vol, "/f", pattern(100, i)), EOk)
    test.assert_eq(names(vol, "/"), "d;big;f;")
    test.assert_eq(read_all(vol, "/f"), pattern(100, 11))
    test.assert_eq(read_all(vol, "/big"), pattern(700, 3))
    let dev = vol.unmount()
    let again = nvfs.mount(dev)
    want(again.status(), EOk)
    test.assert(again.info().rev > 1)
    test.assert_eq(read_all(again, "/f"), pattern(100, 11))
    test.assert_eq(names(again, "/"), "d;big;f;")

@test
fn test_a_directory_whose_live_state_fills_a_block_refuses_more()
    let vol = fresh(32)
    want(hostfs.file_write(vol, "/a", pattern(100, 1)), EOk)
    want(hostfs.file_write(vol, "/b", pattern(100, 2)), EOk)
    want(hostfs.file_write(vol, "/c", pattern(100, 3)), EOk)
    want(hostfs.file_write(vol, "/e", pattern(100, 4)), EOk)
    want(hostfs.file_write(vol, "/g", pattern(100, 5)), ENoSpace)
    test.assert_eq(names(vol, "/"), "a;b;c;e;")

@test
fn test_a_worn_directory_pair_moves_to_fresh_blocks()
    let dev = ram(64)
    want(nvfs.format(dev, cfg_with(2)), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    want(vol.mkdir("/d/e"), EOk)
    var first = 0
    match vol.stat("/d/e")
        EntOk(en) =>
            first = en.pair0 as Int
        EntErr(e) => test.fail("stat: " + nvfs.err_str(e))
    for i in 0..30
        want(hostfs.file_write(vol, "/d/e/f", pattern(100, i)), EOk)
    match vol.stat("/d/e")
        EntOk(en) => test.assert_ne(en.pair0 as Int, first)
        EntErr(e) => test.fail("stat: " + nvfs.err_str(e))
    test.assert_eq(read_all(vol, "/d/e/f"), pattern(100, 29))
    let again = nvfs.mount(vol.unmount())
    test.assert_eq(read_all(again, "/d/e/f"), pattern(100, 29))

@test
fn test_relocation_stops_where_the_volume_is_full()
    let dev = ram(6)
    want(nvfs.format(dev, cfg_with(1)), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    // the two data blocks left are taken, so the pair cannot move
    want(hostfs.file_write(vol, "/x", pattern(900, 0)), EOk)
    want(hostfs.file_write(vol, "/d/f", pattern(10, 1)), EOk)
    test.assert_eq(read_all(vol, "/d/f"), pattern(10, 1))

@test
fn test_relocation_survives_a_block_that_will_not_erase()
    let dev = ram(16)
    want(nvfs.format(dev, cfg_with(1)), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    // the allocator hands out 4 and 5 for the move; neither erases
    hostdev.ram_mark_bad(4)
    hostdev.ram_mark_bad(5)
    want(hostfs.file_write(vol, "/d/f", pattern(10, 1)), EOk)
    want(hostfs.file_write(vol, "/d/f", pattern(10, 2)), EOk)
    test.assert_eq(read_all(vol, "/d/f"), pattern(10, 2))

// ── Superblocks and records written by hand ─────────────────────────

@test
fn test_a_superblock_of_a_newer_major_version_is_refused()
    let dev = ram(16)
    hand_block(dev, 0, 1, 1, sb_payload(0x00020000, 16))
    want(nvfs.mount(dev).status(), EVersion)

@test
fn test_a_short_superblock_is_refused()
    let dev = ram(16)
    // the magic and nothing after it: every field reads -1
    hand_block(dev, 0, 1, 1, [0x4E, 0x56, 0x46, 0x53])
    want(nvfs.mount(dev).status(), EVersion)
    // two bytes of magic
    hand_block(dev, 0, 1, 1, [0x4E, 0x56])
    want(nvfs.mount(dev).status(), ECorrupt)
    // the wrong magic
    hand_block(dev, 0, 1, 1, [0x4E, 0x56, 0x46, 0x54])
    want(nvfs.mount(dev).status(), ECorrupt)

@test
fn test_a_root_without_a_superblock_is_corrupt()
    let dev = ram(16)
    hand_block(dev, 0, 1, 2, dirent_dir("a", 4, 5))
    want(nvfs.mount(dev).status(), ECorrupt)

@test
fn test_the_sealed_block_with_records_wins_over_a_bare_torn_one()
    let dev = ram(16)
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    // block 1 sealed with a high revision and garbage behind it, as an
    // erase cut short can leave it
    meta.cache_drop()
    let _ = dev.erase(1)
    let _ = hostdev.prog_bytes(dev,
        1,
        0,
        bytes.from_byte_list([9, 0, 0, 0, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255]))
    let _ = hostdev.prog_bytes(dev, 1, 16, bytes.from_byte_list([2, 0, 4, 0, 1, 2, 3, 4, 0, 0, 0, 0, 255, 255, 255, 255]))
    let vol = nvfs.mount(dev)
    want(vol.status(), EOk)
    test.assert_eq(vol.info().active_meta, 0)
    want(hostfs.file_write(vol, "/a", pattern(5, 0)), EOk)
    // the same garbage in block 0, with the volume in block 1
    let dev2 = ram(16)
    want(nvfs.format(dev2, nvfs.default_config()), EOk)
    let v2 = nvfs.mount(dev2)
    for i in 0..5
        want(hostfs.file_write(v2, "/f", pattern(100, i)), EOk)
    let d2 = v2.unmount()
    meta.cache_drop()
    let _ = d2.erase(0)
    let _ = hostdev.prog_bytes(d2,
        0,
        0,
        bytes.from_byte_list([9, 0, 0, 0, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255]))
    let _ = hostdev.prog_bytes(d2, 0, 16, bytes.from_byte_list([2, 0, 4, 0, 1, 2, 3, 4, 0, 0, 0, 0, 255, 255, 255, 255]))
    let v3 = nvfs.mount(d2)
    want(v3.status(), EOk)
    test.assert_eq(v3.info().active_meta, 1)
    test.assert_eq(read_all(v3, "/f"), pattern(100, 4))

@test
fn test_the_higher_revision_wins_and_a_lone_sibling_mounts()
    let vol = fresh(16)
    for i in 0..5
        want(hostfs.file_write(vol, "/f", pattern(100, i)), EOk)
    let dev = vol.unmount()
    let v1 = nvfs.mount(dev)
    test.assert_eq(v1.info().active_meta, 1)
    for i in 0..5
        want(hostfs.file_write(v1, "/f", pattern(100, i + 10)), EOk)
    let d1 = v1.unmount()
    let v2 = nvfs.mount(d1)
    test.assert_eq(v2.info().active_meta, 0)
    test.assert_eq(read_all(v2, "/f"), pattern(100, 14))
    // rewrite until the volume is in block 1 again
    var n = 20
    for i in 0..10
        want(hostfs.file_write(v2, "/f", pattern(100, n)), EOk)
        if (nvfs.pair_state(v2.dev, 0, 1).blk as Int) == 1
            break
        n = n + 1
    let d2 = v2.unmount()
    // block 0 erased: block 1 alone holds the volume
    meta.cache_drop()
    let _ = d2.erase(0)
    let v3 = nvfs.mount(d2)
    want(v3.status(), EOk)
    test.assert_eq(v3.info().active_meta, 1)
    test.assert_eq(read_all(v3, "/f"), pattern(100, n))

@test
fn test_a_directory_entry_naming_erased_blocks_is_corrupt()
    let vol = fresh(32)
    let dev = vol.unmount()
    // /x names the pair (20, 21), which holds nothing; /y names one
    // block twice; /z names blocks past the device
    let s = Spec { rtype: 2, kind: 1, a: Span { lo: 1, hi: 2 }, b: Span { lo: 0, hi: 0 }, p0: 20, p1: 21 }
    var stage: Buf = Vec.new()
    want(nvfs.commit(dev, 0, 1, s, "/x", "/x", stage), EOk)
    let s2 = Spec { rtype: 2, kind: 1, a: Span { lo: 1, hi: 2 }, b: Span { lo: 0, hi: 0 }, p0: 5, p1: 5 }
    want(nvfs.commit(dev, 0, 1, s2, "/y", "/y", stage), EOk)
    let s3 = Spec { rtype: 2, kind: 1, a: Span { lo: 1, hi: 2 }, b: Span { lo: 0, hi: 0 }, p0: 40, p1: 41 }
    want(nvfs.commit(dev, 0, 1, s3, "/z", "/z", stage), EOk)
    let v = nvfs.mount(dev)
    want(v.status(), EOk)
    want(v.mkdir("/x/a"), ECorrupt)
    want(v.mkdir("/x/a/b"), ECorrupt)
    want(v.mkdir("/y/a"), ECorrupt)
    want(v.mkdir("/z/a"), ECorrupt)
    want(v.remove("/x/a"), ECorrupt)
    want(v.remove("/x"), ECorrupt)
    want(v.rename("/x/a", "/x/b"), ECorrupt)
    want(hostfs.file_write(v, "/x/a", pattern(1, 0)), ECorrupt)
    want(v.dir_open("/x").err, ECorrupt)
    match hostfs.file_read(v, "/x/a")
        FOk(b)  => test.fail("read under a corrupt directory")
        FErr(e) => want(e, ECorrupt)
    // the walk that marks live blocks passes over the broken pairs
    test.assert(v.used_blocks() >= 2)

@test
fn test_a_commit_to_a_pair_that_holds_nothing_is_corrupt()
    let vol = fresh(16)
    let dev = vol.unmount()
    let s = Spec { rtype: 3, kind: 0, a: Span { lo: 1, hi: 2 }, b: Span { lo: 0, hi: 0 }, p0: 0, p1: 0 }
    var stage: Buf = Vec.new()
    want(nvfs.commit(dev, 10, 11, s, "/a", "/a", stage), ECorrupt)

@test
fn test_a_rename_onto_a_name_whose_old_name_is_absent_keeps_the_name()
    let vol = fresh(32)
    want(hostfs.file_write(vol, "/b", pattern(7, 7)), EOk)
    let dev = vol.unmount()
    // a rename record from "a", which does not exist, onto "b"
    let s = Spec { rtype: 4, kind: 0, a: Span { lo: 1, hi: 2 }, b: Span { lo: 3, hi: 4 }, p0: 0, p1: 0 }
    var stage: Buf = Vec.new()
    want(nvfs.commit(dev, 0, 1, s, "/a", "/x/b", stage), EOk)
    let v = nvfs.mount(dev)
    test.assert_eq(read_all(v, "/b"), pattern(7, 7))
    test.assert_eq(names(v, "/"), "b;")

@test
fn test_a_dirent_shorter_than_its_header_reads_as_empty()
    let dev = ram(16)
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    // an inline dirent whose name length runs past its payload
    let _ = put_rec(dev, 0, 64, 2, [2, 9, 97])
    meta.cache_drop()
    let r = meta.rec_at(dev, 0, 64, 512)
    test.assert(r.ok)
    let en = nvfs.dec_dirent(dev, 0, r)
    test.assert_eq(en.size as Int, 0)
    // a dirent with no payload at all
    let _ = put_rec(dev, 0, 80, 2, [])
    meta.cache_drop()
    let r2 = meta.rec_at(dev, 0, 80, 512)
    let en2 = nvfs.dec_dirent(dev, 0, r2)
    test.assert_eq(en2.kind as Int, 0)
    test.assert_eq(en2.pair0 as Int, 0)

// ── Devices that fail ───────────────────────────────────────────────

@test
fn test_an_append_the_device_refuses_is_an_io_error()
    let vol = fresh(16)
    hostdev.ram_mark_bad(0)
    want(hostfs.file_write(vol, "/a", pattern(5, 0)), EIo)

@test
fn test_a_compaction_the_device_refuses_is_an_io_error()
    let vol = fresh(16)
    for i in 0..4
        want(hostfs.file_write(vol, "/f", pattern(100, i)), EOk)
    // the erase of the sibling fails
    hostdev.ram_mark_bad(1)
    want(hostfs.file_write(vol, "/f", pattern(100, 9)), EIo)
    test.assert_eq(read_all(vol, "/f"), pattern(100, 3))

@test
fn test_a_compaction_cut_at_each_step_keeps_the_old_state()
    // count the operations the compacting write takes, then cut power
    // at each of them in turn
    let vol = fresh(16)
    for i in 0..4
        want(hostfs.file_write(vol, "/f", pattern(100, i)), EOk)
    hostdev.ram_op_count_reset()
    want(hostfs.file_write(vol, "/f", pattern(100, 9)), EOk)
    let n = hostdev.ram_op_count_get()
    test.assert(n >= 3)
    for k in 1..n + 1
        let v = fresh(16)
        for i in 0..4
            want(hostfs.file_write(v, "/f", pattern(100, i)), EOk)
        hostdev.ram_schedule_cut(k, -1)
        let r = hostfs.file_write(v, "/f", pattern(100, 9))
        hostdev.ram_clear_cut()
        want(r, EIo)
        let again = nvfs.mount(v.unmount())
        want(again.status(), EOk)
        test.assert_eq(read_all(again, "/f"), pattern(100, 3))

@test
fn test_a_sync_the_device_refuses()
    // format: the sync after the record, after the seal, and the last
    for k in 0..3
        let dev = FaultFlash { ram: ram(16) }
        syncs_left = k
        want(nvfs.format(dev, nvfs.default_config()), EIo)
        faults_off()
    // an append
    let d1 = FaultFlash { ram: ram(16) }
    want(nvfs.format(d1, nvfs.default_config()), EOk)
    let v1 = nvfs.mount(d1)
    syncs_left = 0
    want(hostfs.file_write(v1, "/a", pattern(5, 0)), EIo)
    faults_off()
    // a compaction, before and after its seal
    for k in 0..2
        let d2 = FaultFlash { ram: ram(16) }
        want(nvfs.format(d2, nvfs.default_config()), EOk)
        let v2 = nvfs.mount(d2)
        for i in 0..4
            want(hostfs.file_write(v2, "/f", pattern(100, i)), EOk)
        syncs_left = k
        want(hostfs.file_write(v2, "/f", pattern(100, 9)), EIo)
        faults_off()
    // a chain's last sync
    let d3 = FaultFlash { ram: ram(16) }
    want(nvfs.format(d3, nvfs.default_config()), EOk)
    let v3 = nvfs.mount(d3)
    syncs_left = 0
    want(hostfs.file_write(v3, "/big", pattern(700, 0)), EIo)
    faults_off()

@test
fn test_a_root_that_cannot_be_read_is_corrupt()
    let dev = FaultFlash { ram: ram(16) }
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    fail_read_block = 0
    want(nvfs.mount(dev).status(), ECorrupt)
    faults_off()

@test
fn test_reads_that_fail_part_way()
    // every count of reads before the failure, over a volume with a
    // directory, an inline file and a chain
    for k in 0..400
        let dev = FaultFlash { ram: ram(16) }
        want(nvfs.format(dev, nvfs.default_config()), EOk)
        let vol = nvfs.mount(dev)
        want(vol.mkdir("/d"), EOk)
        want(hostfs.file_write(vol, "/d/s", pattern(50, 1)), EOk)
        want(hostfs.file_write(vol, "/d/c", pattern(1200, 2)), EOk)
        let v = nvfs.mount(vol.unmount())
        reads_left = k
        let _ = hostfs.file_read(v, "/d/c")
        let _ = hostfs.file_read(v, "/d/s")
        let _ = hostfs.dir_list(v, "/d")
        let _ = hostfs.file_append(v, "/d/c", pattern(10, 0))
        let _ = v.file_truncate("/d/c", 700)
        let _ = v.rename("/d/s", "/d/t")
        let _ = v.used_blocks()
        faults_off()

// A volume whose root is one rewrite from a compaction and whose
// directory /d/e moves to fresh blocks on every commit.
fn moving_volume(rs: Int, ps: Int, bs: Int) -> Volume<FaultFlash> [mutate, ffi]
    ram_recycle()
    faults_off()
    nvfs.wear_reset()
    let dev = FaultFlash { ram: hostdev.ram_flash(rs, ps, bs, 32) }
    want(nvfs.format(dev, cfg_with(1)), EOk)
    let vol = nvfs.mount(dev)
    want(vol.mkdir("/d"), EOk)
    want(vol.mkdir("/d/e"), EOk)
    want(hostfs.file_write(vol, "/d/e/s", pattern(60, 1)), EOk)
    want(hostfs.file_write(vol, "/d/e/c", pattern(700, 2)), EOk)
    for i in 0..(bs - 64) / 112
        want(hostfs.file_write(vol, "/f", pattern(100, i)), EOk)
    nvfs.mount(vol.unmount())

fn moving_work(v: Volume<FaultFlash>) [mutate, ffi]
    let _ = hostfs.file_write(v, "/f", pattern(100, 9))
    let _ = hostfs.file_write(v, "/d/e/s", pattern(60, 9))
    let _ = hostfs.file_append(v, "/d/e/s", pattern(10, 0))
    let _ = v.file_truncate("/d/e/s", 20)
    let _ = hostfs.file_read(v, "/d/e/c")

@test
fn test_reads_that_fail_part_way_through_a_compaction_and_a_move()
    for g in 0..3
        var rs = 16
        var ps = 16
        var bs = 512
        if g == 1
            rs = 1
            ps = 1
            bs = 1024
        else if g == 2
            rs = 4
            ps = 4
            bs = 2048
        let v0 = moving_volume(rs, ps, bs)
        reads_done = 0
        moving_work(v0)
        let n = reads_done
        for k in 0..n + 1
            let v = moving_volume(rs, ps, bs)
            reads_left = k
            moving_work(v)
            faults_off()

@test
fn test_reads_that_fail_part_way_through_a_mount()
    for g in 0..2
        ram_recycle()
        faults_off()
        nvfs.wear_reset()
        var ramdev = hostdev.ram_flash(16, 16, 512, 16)
        var files = 3
        if g == 1
            ramdev = hostdev.ram_flash(1, 1, 2048, 16)
            files = 20
        want(nvfs.format(ramdev, nvfs.default_config()), EOk)
        let vol = nvfs.mount(ramdev)
        want(vol.mkdir("/d"), EOk)
        for i in 0..files
            want(hostfs.file_write(vol, "/a" + str.from_int(i), pattern(50 + i, i)), EOk)
        let dev = FaultFlash { ram: vol.unmount() }
        reads_done = 0
        let _ = nvfs.mount(dev).status()
        let n = reads_done
        for k in 0..n + 1
            faults_off()
            reads_left = k
            let _ = nvfs.mount(dev).status()
            faults_off()

// A rename record from `old` onto `new`, committed to the root as it
// stands, whether or not `old` exists.
fn hand_rename<D: Flash[e]>(dev: D, old: Str, new: Str) -> FsError [mutate, e]
    let both = old + new
    let s = Spec { rtype: 4, kind: 0, a: Span { lo: 0, hi: str.len(old) },
                   b: Span { lo: str.len(old), hi: str.len(both) }, p0: 0, p1: 0 }
    var stage: Buf = Vec.new()
    nvfs.commit(dev, 0, 1, s, both, both, stage)

@test
fn test_a_rename_chain_through_an_absent_name_backs_out_a_level()
    let vol = fresh(32)
    want(hostfs.file_write(vol, "/b", pattern(6, 6)), EOk)
    let dev = vol.unmount()
    // y, which never existed, onto b; then b onto c
    want(hand_rename(dev, "y", "b"), EOk)
    want(hand_rename(dev, "b", "c"), EOk)
    let v = nvfs.mount(dev)
    test.assert_eq(read_all(v, "/c"), pattern(6, 6))
    test.assert_eq(names(v, "/"), "c;")
    // q, which never existed, onto p; then p onto r: nothing is named
    let d2 = v.unmount()
    want(hand_rename(d2, "q", "p"), EOk)
    want(hand_rename(d2, "p", "r"), EOk)
    let v2 = nvfs.mount(d2)
    match v2.stat("/r")
        EntOk(en) => test.fail("r names an entry")
        EntErr(e) => want(e, ENotFound)

@test
fn test_renames_from_an_absent_name_stop_at_the_depth_bound()
    ram_recycle()
    faults_off()
    nvfs.wear_reset()
    let dev = hostdev.ram_flash(16, 16, 4096, 16)
    want(nvfs.format(dev, nvfs.default_config()), EOk)
    for i in 0..40
        want(hand_rename(dev, "y", "a"), EOk)
    let v = nvfs.mount(dev)
    match v.stat("/a")
        EntOk(en) => test.fail("a names an entry")
        EntErr(e) => want(e, ENotFound)

@test
fn test_a_record_header_that_straddles_two_read_windows()
    // 30-byte records on a device that reads single bytes: a record's
    // header can start in one short read window and end in the next
    ram_recycle()
    faults_off()
    nvfs.wear_reset()
    let ramdev = hostdev.ram_flash(1, 1, 2048, 8)
    want(nvfs.format(ramdev, nvfs.default_config()), EOk)
    let vol = nvfs.mount(ramdev)
    for i in 10..50
        want(hostfs.file_write(vol, "/a" + str.from_int(i), pattern(17, i)), EOk)
    let dev = FaultFlash { ram: vol.unmount() }
    let v0 = nvfs.mount(dev)
    reads_done = 0
    let _ = v0.stat("/zz")
    let n = reads_done
    for k in 0..n + 1
        let v = nvfs.mount(dev)
        reads_left = k
        match v.stat("/zz")
            EntOk(en) => test.fail("zz names an entry")
            EntErr(e) => test.assert(e == ENotFound or e == ECorrupt)
        faults_off()
