// examples/crossmount.nv — a volume made on the host,
// mounted and written by the device-built core.
//
//   novofs mk tree -o novo_block.img --block-size 512 --block-count 64
//   novo build --target=nrf52-qemu crossmount.nv
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting \
//       -kernel crossmount.elf
//
// The build needs the novofs modules flash, crc32, meta, nvfs and
// halflash beside this file, with devtools.nv.
//
// Under QEMU the board's block storage is `novo_block.img` in QEMU's
// working directory, 64 blocks of 512 bytes over semihosting, and
// HalFlash is the Flash device over it.  The example mounts the image
// the host tool made and prints its digest, then makes a directory,
// writes a CTZ file and appends to it, and prints the digest again.
// The host reads the same image back through FileFlash and must find
// both digests: the host's `mk` image as the device read it, and the
// device's writes as the host reads them.

use flash
use nvfs
use halflash
use devtools

fn main() [hw, async, mutate]
    bsp.board.init()
    let dev = halflash.hal_flash()
    let before = devtools.volume_digest(dev)
    devtools.say("novofs-qemu: cross host image digest ")
    devtools.num(before)
    devtools.say("\n")
    if before < 0
        devtools.say("novofs-qemu: cross FAIL mount\n")
        return
    let vol1 = nvfs.mount(dev)
    match vol1.mounted()
        MErr(e)   => devtools.say("novofs-qemu: cross FAIL remount\n")
        MOk(info) =>
            let m = vol1.mkdir("/device")
            let w = vol1.file_write("/device/log", Pat { n: 700, seed: 9 })
            let a = vol1.file_append("/device/log", Word { v: 0x4E564653 })
            let after = devtools.volume_digest(dev)
            devtools.say("novofs-qemu: cross device digest ")
            devtools.num(after)
            devtools.say("\n")
            if m == EOk and w == EOk and a == EOk and after >= 0
                devtools.say("novofs-qemu: cross PASS\n")
            else
                devtools.say("novofs-qemu: cross FAIL write ")
                devtools.say(nvfs.err_str(m))
                devtools.say(" ")
                devtools.say(nvfs.err_str(w))
                devtools.say(" ")
                devtools.say(nvfs.err_str(a))
                devtools.say("\n")
