// examples/powerloss.nv — the power-loss loop on a
// device, scaled down from the host torture harness.
//
//   novo build --target=nrf52-qemu powerloss.nv
//   qemu-system-arm -machine mps2-an386 -nographic -semihosting \
//       -kernel powerloss.elf
//
// The build needs the novofs modules flash, crc32, meta and nvfs from
// src/ beside this file, with emram.nv and devtools.nv from this
// directory; the novo-lang repository's QEMU gate,
// tests/orbit/test_novofs_qemu.sh, assembles them.
//
// A scripted workload — a directory, inline and CTZ files, an append,
// a rename, a truncate, a remove, and churn that forces compactions
// and, with block_cycles 2, pair relocations — runs once uncut on an
// EmRam device, recording the tree's digest after every step and the
// number of progs and erases.  Then, for every cut point k in that
// trace and for a clean and a torn cut, the workload runs again on a
// fresh volume with power cut after k operations; power is restored,
// the volume must mount, and its digest must equal the digest after
// the steps that completed, or after one more (a torn commit may have
// sealed; atomicity is promised, being told about it is not).
//
// Output is three lines: the trace, the counts, the banner
// `novofs-qemu: powerloss PASS` (or FAIL with the first bad cut).

use nvfs
use emram
use devtools

let STEPS = 14
let TEAR  = 8

var model: Vec[Int; 16] = Vec.new()

fn cfg() -> FsConfig
    let c = nvfs.default_config()
    FsConfig {
        block_cycles: 2,
        cache_size: c.cache_size,
        lookahead_size: c.lookahead_size,
        name_max: c.name_max,
        file_max: c.file_max,
        inline_max: c.inline_max }

// Step `i` of the workload.
fn step(vol: Volume<EmRam>, i: Int) -> FsError [mutate]
    if i == 0
        vol.mkdir("/a")
    else if i == 1
        vol.file_write("/a/x", Pat { n: 20, seed: 1 })
    else if i == 2
        vol.file_write("/big", Pat { n: 1200, seed: 2 })
    else if i == 3
        vol.file_append("/a/x", Pat { n: 10, seed: 3 })
    else if i == 4
        vol.rename("/a/x", "/a/y")
    else if i == 5
        vol.file_truncate("/big", 600)
    else if i == 6
        vol.file_write("/c", Pat { n: 5, seed: 4 })
    else if i == 7
        vol.remove("/c")
    else
        // churn: rewrite /a/y, compacting the /a pair
        vol.file_write("/a/y", Pat { n: 40 + i, seed: i })

// A fresh volume, formatted and mounted; a failed format or mount
// answers a volume that did not mount.
fn fresh(dev: EmRam) -> Volume<EmRam> [mutate]
    nvfs.wear_reset()
    let _ = nvfs.format(dev, cfg())
    nvfs.mount(dev)

// Runs the workload; answers the number of steps that answered EOk
// before the first that did not.
fn run(vol: Volume<EmRam>) -> Int [mutate]
    var done = 0
    for i in 0..STEPS
        if step(vol, i) != EOk
            break
        done = done + 1
    done

fn main() [hw, mutate]
    bsp.board.init()
    var dev = emram.emram(16, 16, 512, 16)

    // the uncut trace and its model
    let vol0 = fresh(dev)
    if vol0.status() != EOk
        devtools.say("novofs-qemu: powerloss FAIL format\n")
        return
    let base_ops = emram.em_ops()
    // The model is read through the volume the workload runs on, not a
    // second mount: a mount reseeds the allocator's cursor, and the cut
    // runs below mount once.
    let _ = model.push(devtools.digest(vol0, 0, 1, 0))
    var ok_steps = 0
    for i in 0..STEPS
        if step(vol0, i) != EOk
            break
        let _ = model.push(devtools.digest(vol0, 0, 1, 0))
        ok_steps = ok_steps + 1
    let ops = emram.em_ops() - base_ops
    devtools.say("novofs-qemu: powerloss trace steps ")
    devtools.num(ok_steps)
    devtools.say(" ops ")
    devtools.num(ops)
    devtools.say("\n")
    if ok_steps != STEPS
        devtools.say("novofs-qemu: powerloss FAIL uncut workload\n")
        return

    // every cut point, clean and torn
    var cuts = 0
    var fails = 0
    var first_bad = -1
    for tv in 0..2
        var tear = -1
        if tv == 1
            tear = TEAR
        for k in 1..ops + 1
            dev = emram.emram(16, 16, 512, 16)
            let vol = fresh(dev)
            emram.em_schedule_cut(k, tear)
            let done = run(vol)
            emram.em_restore()
            let d = devtools.volume_digest(dev)
            cuts = cuts + 1
            var good = d >= 0 and d == model[done]
            if not good and done + 1 <= STEPS
                good = d >= 0 and d == model[done + 1]
            if not good
                fails = fails + 1
                if first_bad < 0
                    first_bad = k + tv * 1000
    devtools.say("novofs-qemu: powerloss cuts ")
    devtools.num(cuts)
    devtools.say(" fails ")
    devtools.num(fails)
    devtools.say("\n")
    if fails == 0 and cuts >= 32
        devtools.say("novofs-qemu: powerloss PASS\n")
    else
        devtools.say("novofs-qemu: powerloss FAIL first cut ")
        devtools.num(first_bad)
        devtools.say("\n")
